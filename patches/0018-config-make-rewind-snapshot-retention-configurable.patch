From d698880d432bb6dc235a28cb2e4e34240b03156b Mon Sep 17 00:00:00 2001
From: codEx Fork Bot <codex-fork-bot@localhost>
Date: Wed, 12 Aug 2026 22:32:14 +0800
Subject: config: make rewind snapshot retention configurable

- Adds rewind_max_snapshots (default 20, clamped to 1-10000) controlling
  how many file snapshots are retained per conversation, mirroring Claude
  Code's configurable checkpoint retention and addressing the fixed
  workspace-wide cap.
---
 codex-rs/config/src/config_toml.rs         | 4 ++++
 codex-rs/core/config.schema.json           | 8 +++++++-
 codex-rs/core/src/config/config_tests.rs   | 3 +++
 codex-rs/core/src/config/mod.rs            | 9 +++++++++
 codex-rs/thread-manager-sample/src/main.rs | 1 +
 5 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/codex-rs/config/src/config_toml.rs b/codex-rs/config/src/config_toml.rs
index 6fce616..93bfb9c 100644
--- a/codex-rs/config/src/config_toml.rs
+++ b/codex-rs/config/src/config_toml.rs
@@ -482,6 +482,10 @@ pub struct ConfigToml {
     /// Defaults to `true`.
     pub rewind_respect_gitignore: Option<bool>,
 
+    /// Maximum number of `/rewind` file snapshots retained per conversation.
+    /// Defaults to `20`.
+    pub rewind_max_snapshots: Option<usize>,
+
     /// When true, disables burst-paste detection for typed input entirely.
     /// All characters are inserted as they are received, and no buffering
     /// or placeholder replacement will occur for fast keypress bursts.
diff --git a/codex-rs/core/config.schema.json b/codex-rs/core/config.schema.json
index 7bd126f..9c7607d 100644
--- a/codex-rs/core/config.schema.json
+++ b/codex-rs/core/config.schema.json
@@ -5750,6 +5750,12 @@
       "description": "When `true`, `/rewind` snapshots respect `.gitignore` (and skip the `.git` directory). Set to `false` to snapshot every file. Defaults to `true`.",
       "type": "boolean"
     },
+    "rewind_max_snapshots": {
+      "description": "Maximum number of `/rewind` file snapshots retained per conversation. Defaults to `20`.",
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 10000
+    },
     "sandbox_mode": {
       "allOf": [
         {
@@ -5860,4 +5866,4 @@
   },
   "title": "ConfigToml",
   "type": "object"
-}
\ No newline at end of file
+}
diff --git a/codex-rs/core/src/config/config_tests.rs b/codex-rs/core/src/config/config_tests.rs
index 64625c7..bb0b389 100644
--- a/codex-rs/core/src/config/config_tests.rs
+++ b/codex-rs/core/src/config/config_tests.rs
@@ -540,6 +540,7 @@ async fn rewind_defaults_on_and_respects_gitignore() -> std::io::Result<()> {
         .await?;
     assert!(config.rewind_enabled);
     assert!(config.rewind_respect_gitignore);
+    assert_eq!(config.rewind_max_snapshots, 20);
     assert!(!config.check_for_update_on_startup);
     Ok(())
 }
@@ -552,6 +553,7 @@ async fn rewind_can_be_disabled_in_config() -> std::io::Result<()> {
         r#"
 rewind_enabled = false
 rewind_respect_gitignore = false
+rewind_max_snapshots = 5
 "#,
     )?;
     let config = ConfigBuilder::default()
@@ -560,6 +562,7 @@ rewind_respect_gitignore = false
         .await?;
     assert!(!config.rewind_enabled);
     assert!(!config.rewind_respect_gitignore);
+    assert_eq!(config.rewind_max_snapshots, 5);
     Ok(())
 }
 
