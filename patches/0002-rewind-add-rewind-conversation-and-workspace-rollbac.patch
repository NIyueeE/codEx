@@ -0,0 +1,376 @@
+//! `/rewind` UI actions: scope picker, message picker, snapshot picker, and
+//! file restoration. The file snapshot engine lives in [`super`].
+
+use crate::app::App;
+use crate::app_backtrack::BacktrackSelection;
+use crate::app_event::AppEvent;
+use crate::app_event::RewindRestoreRequest;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::popup_consts::standard_popup_hint_line;
+use crate::rewind;
+use crate::tui;
+
+const REWIND_TITLE: &str = "Rewind";
+const NO_MESSAGES_TO_REWIND: &str = "No previous messages to rewind.";
+const NO_SNAPSHOTS_TO_REWIND: &str =
+    "No file snapshots yet. Snapshots are taken before each turn when /rewind is enabled.";
+
+impl App {
+    /// Shows the `/rewind` scope picker.
+    pub(crate) fn show_rewind_scope_picker(&mut self) {
+        self.chat_widget
+            .show_selection_view(rewind_scope_selection_params());
+    }
+
+    /// Opens the transcript overlay for conversation rollback, reusing the
+    /// original double-Esc backtrack picker instead of a custom list.
+    pub(crate) fn show_rewind_message_picker(&mut self, tui: &mut tui::Tui, restore_files: bool) {
+        if !self.begin_rewind_overlay_selection(tui, restore_files) {
+            self.chat_widget
+                .add_info_message(NO_MESSAGES_TO_REWIND.to_string(), /*hint*/ None);
+        }
+    }
+
+    /// Shows the snapshot picker for file-only rollback.
+    pub(crate) fn show_rewind_snapshot_picker(&mut self) {
+        let snapshots = rewind::list_workspace_snapshots(
+            self.config.codex_home.as_path(),
+            self.config.cwd.as_path(),
+        );
+        if snapshots.is_empty() {
+            self.chat_widget
+                .add_info_message(NO_SNAPSHOTS_TO_REWIND.to_string(), /*hint*/ None);
+            return;
+        }
+
+        let items = snapshots
+            .into_iter()
+            .map(|snapshot| SelectionItem {
+                name: format!("Turn {}", snapshot.index),
+                description: Some(snapshot_label(&snapshot)),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::RewindPreviewSnapshot {
+                        thread_id: snapshot.thread_id.clone(),
+                        index: snapshot.index,
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            })
+            .collect();
+
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            view_id: Some("rewind_snapshots"),
+            title: Some(REWIND_TITLE.to_string()),
+            subtitle: Some("Pick a snapshot to restore workspace files from".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            is_searchable: false,
+            items,
+            ..Default::default()
+        });
+    }
+
+    /// Shows a confirmation with a dry-run preview before restoring the
+    /// workspace from a stored snapshot. When nothing would change, the
+    /// restore is skipped without asking (mirrors Claude Code's rewind
+    /// fast path).
+    pub(crate) fn show_rewind_restore_confirmation(&mut self, thread_id: &str, index: u64) {
+        let codex_home = self.config.codex_home.as_path();
+        let cwd = self.config.cwd.as_path();
+        let preview = match rewind::preview_restore(codex_home, cwd, thread_id, index) {
+            Ok(preview) => preview,
+            Err(err) => {
+                self.chat_widget
+                    .add_error_message(format!("Failed to preview snapshot {index}: {err}"));
+                return;
+            }
+        };
+        if preview.restore_count == 0 && preview.delete_count == 0 {
+            self.chat_widget
+                .add_info_message(format!("Nothing to restore from snapshot {index}."), None);
+            return;
+        }
+
+        let label = self
+            .snapshot_label_for(thread_id, index)
+            .unwrap_or_else(|| format!("Turn {index}"));
+        let thread_id = thread_id.to_string();
+        let params = SelectionViewParams {
+            view_id: Some("rewind_confirm_restore"),
+            title: Some(format!("Restore snapshot {index}?")),
+            subtitle: Some(format!(
+                "Would restore {} file(s) and delete {} file(s).",
+                preview.restore_count, preview.delete_count
+            )),
+            footer_hint: Some(standard_popup_hint_line()),
+            is_searchable: false,
+            items: vec![
+                SelectionItem {
+                    name: "Restore".to_string(),
+                    description: Some(label),
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::RewindRestoreSnapshot {
+                            thread_id: thread_id.clone(),
+                            index,
+                        });
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+                SelectionItem {
+                    name: "Cancel".to_string(),
+                    description: Some("Leave the workspace untouched".to_string()),
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+            ],
+            ..Default::default()
+        };
+        self.chat_widget.show_selection_view(params);
+    }
+
+    /// Shows a confirmation for a "Files and conversation" rewind: previews
+    /// the file changes and defers the fork to the confirm action. When no
+    /// matching snapshot exists, the conversation still rewinds without
+    /// touching files (mirrors Claude Code's behavior); when nothing would
+    /// change, the fork proceeds immediately.
+    pub(crate) fn show_rewind_fork_confirmation(
+        &mut self,
+        selection: BacktrackSelection,
+        request: RewindRestoreRequest,
+    ) {
+        let codex_home = self.config.codex_home.as_path();
+        let cwd = self.config.cwd.as_path();
+        let resolved = self.resolve_rewind_restore_target(&request);
+        let Some((restore_thread_id, snapshot_index)) = resolved else {
+            self.chat_widget.add_info_message(
+                "No matching file snapshot found for this message; rewinding the conversation without file changes."
+                    .to_string(),
+                /*hint*/ None,
+            );
+            self.apply_backtrack_selection(selection);
+            return;
+        };
+        let preview =
+            match rewind::preview_restore(codex_home, cwd, &restore_thread_id, snapshot_index) {
+                Ok(preview) => preview,
+                Err(err) => {
+                    self.chat_widget.add_error_message(format!(
+                        "Failed to preview snapshot {snapshot_index}: {err}"
+                    ));
+                    return;
+                }
+            };
+        if preview.restore_count == 0 && preview.delete_count == 0 {
+            self.apply_backtrack_selection(selection);
+            return;
+        }
+
+        let request_for_confirm = request.clone();
+        let fork_thread_id = selection.thread_id;
+        let fork_nth_user_message = selection.nth_user_message;
+        let fork_prompt = selection.prompt.clone();
+        let params = SelectionViewParams {
+            view_id: Some("rewind_confirm_fork"),
+            title: Some("Rewind before this message?".to_string()),
+            subtitle: Some(format!(
+                "Would restore {} file(s) and delete {} file(s) from snapshot {snapshot_index}.",
+                preview.restore_count, preview.delete_count
+            )),
+            footer_hint: Some(standard_popup_hint_line()),
+            is_searchable: false,
+            items: vec![
+                SelectionItem {
+                    name: "Rewind".to_string(),
+                    description: Some(
+                        "Fork the chat before the selected message and restore these files"
+                            .to_string(),
+                    ),
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::ForkSessionForPromptEdit {
+                            thread_id: fork_thread_id,
+                            nth_user_message: fork_nth_user_message,
+                            prompt: fork_prompt.clone(),
+                            restore_files: Some(request_for_confirm.clone()),
+                        });
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+                SelectionItem {
+                    name: "Cancel".to_string(),
+                    description: Some("Keep the conversation and files as they are".to_string()),
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+            ],
+            ..Default::default()
+        };
+        self.chat_widget.show_selection_view(params);
+    }
+
+    /// Restores workspace files from snapshot `index` in the given
+    /// conversation's chain.
+    pub(crate) fn rewind_restore_snapshot(&mut self, thread_id: &str, index: u64) {
+        // Like opencode's revert flow, refuse to touch the workspace while a
+        // turn is running: restoring mid-turn would race the agent's writes
+        // and interleave file states.
+        if self.chat_widget.is_task_running() {
+            self.chat_widget.add_error_message(
+                "Cannot restore files while a task is running. Wait for the turn to finish, then try again."
+                    .to_string(),
+            );
+            return;
+        }
+        match rewind::restore_snapshot(
+            self.config.codex_home.as_path(),
+            self.config.cwd.as_path(),
+            thread_id,
+            index,
+        ) {
+            Ok(restored) => {
+                self.chat_widget.add_info_message(
+                    format!("Restored {restored} file(s) from snapshot {index}."),
+                    /*hint*/ None,
+                );
+            }
+            Err(err) => {
+                self.chat_widget
+                    .add_error_message(format!("Failed to restore snapshot {index}: {err}"));
+            }
+        }
+    }
+
+    /// Restores workspace files for a conversation rewind.
+    ///
+    /// `index` is the snapshot index expected from the transcript-ordinal
+    /// mapping (`nth + 1`). The snapshot's recorded prompt is verified against
+    /// the selected message and used to locate the matching snapshot when
+    /// submissions and transcript cells drifted. When the conversation's own
+    /// chain has no match (e.g. the selected message was replayed into a
+    /// rewind fork), the workspace-wide store is consulted so the parent
+    /// conversation's snapshots still resolve. Files are left untouched when
+    /// no snapshot matches.
+    pub(crate) fn rewind_restore_files(&mut self, thread_id: String, index: u64, prompt: String) {
+        let request = RewindRestoreRequest {
+            thread_id,
+            index,
+            prompt,
+        };
+        let Some((restore_thread_id, snapshot_index)) =
+            self.resolve_rewind_restore_target(&request)
+        else {
+            self.chat_widget.add_error_message(
+                "No matching file snapshot found for this message; files were not restored."
+                    .to_string(),
+            );
+            return;
+        };
+        self.rewind_restore_snapshot(&restore_thread_id, snapshot_index);
+    }
+
+    /// Locates the snapshot to restore for a conversation rewind: first in
+    /// the conversation's own chain, then across the workspace (rewind forks
+    /// replay messages whose snapshots live in the parent conversation).
+    fn resolve_rewind_restore_target(
+        &self,
+        request: &RewindRestoreRequest,
+    ) -> Option<(String, u64)> {
+        let codex_home = self.config.codex_home.as_path();
+        let cwd = self.config.cwd.as_path();
+        let thread_snapshots = rewind::list_snapshots(codex_home, cwd, &request.thread_id);
+        match rewind::resolve_snapshot_for_message(
+            &thread_snapshots,
+            request.index,
+            &request.prompt,
+        ) {
+            Some(snapshot) => Some((snapshot.thread_id, snapshot.index)),
+            None => {
+                let workspace_snapshots = rewind::list_workspace_snapshots(codex_home, cwd);
+                rewind::resolve_workspace_snapshot_for_message(
+                    &workspace_snapshots,
+                    request.index,
+                    &request.prompt,
+                )
+            }
+        }
+    }
+
+    fn snapshot_label_for(&self, thread_id: &str, index: u64) -> Option<String> {
+        let codex_home = self.config.codex_home.as_path();
+        let cwd = self.config.cwd.as_path();
+        rewind::list_snapshots(codex_home, cwd, thread_id)
+            .into_iter()
+            .find(|snapshot| snapshot.index == index)
+            .or_else(|| {
+                rewind::list_workspace_snapshots(codex_home, cwd)
+                    .into_iter()
+                    .find(|snapshot| snapshot.thread_id == thread_id && snapshot.index == index)
+            })
+            .map(|snapshot| snapshot_label(&snapshot))
+    }
+}
+
+/// Builds the `/rewind` scope picker (files and/or conversation rollback).
+pub(crate) fn rewind_scope_selection_params() -> SelectionViewParams {
+    SelectionViewParams {
+        view_id: Some("rewind_scope"),
+        title: Some(REWIND_TITLE.to_string()),
+        subtitle: Some("Choose what to roll back".to_string()),
+        footer_hint: Some(standard_popup_hint_line()),
+        is_searchable: false,
+        items: vec![
+            SelectionItem {
+                name: "Files and conversation".to_string(),
+                description: Some(
+                    "Restore workspace files and fork the chat before a message".to_string(),
+                ),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::OpenRewindMessagePicker {
+                        restore_files: /*restore_files*/ true,
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Conversation only".to_string(),
+                description: Some(
+                    "Fork the chat before a message without touching files".to_string(),
+                ),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::OpenRewindMessagePicker {
+                        restore_files: /*restore_files*/ false,
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Files only".to_string(),
+                description: Some("Restore workspace files from an earlier snapshot".to_string()),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::OpenRewindSnapshotPicker);
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+        ],
+        ..Default::default()
+    }
+}
+
+fn snapshot_label(snapshot: &rewind::RewindSnapshotInfo) -> String {
+    let timestamp = chrono::DateTime::from_timestamp(snapshot.created_at, /*nsecs*/ 0)
+        .map(|dt| dt.format("%Y-%m-%d %H:%M").to_string())
+        .unwrap_or_else(|| "unknown time".to_string());
+    let files = match snapshot.changed_file_count {
+        0 => "no file changes".to_string(),
+        1 => "1 file changed".to_string(),
+        count => format!("{count} files changed"),
+    };
+    let short = snapshot.thread_id.chars().take(8).collect::<String>();
+    let thread = format!(" [{short}]");
+    format!("{timestamp}{thread} — {} · {files}", snapshot.prompt)
+}
