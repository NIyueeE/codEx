+            runtime_workspace_roots: Vec::new(),
+            instruction_source_paths: Vec::new(),
+            reasoning_effort: None,
+            collaboration_mode: None,
+            personality: None,
+            message_history: None,
+            network_proxy: None,
+            rollout_path: Some(PathBuf::new()),
+        });
+    let user_cell = |text: &str| -> Arc<dyn HistoryCell> {
+        Arc::new(UserHistoryCell {
+            message: text.to_string(),
+            text_elements: Vec::new(),
+            local_image_paths: Vec::new(),
+            remote_image_urls: Vec::new(),
+        }) as Arc<dyn HistoryCell>
+    };
+    app.transcript_cells = vec![
+        user_cell("first question"),
+        plain_line_cell("answer first"),
+        user_cell("second question"),
+        plain_line_cell("answer second"),
+    ];
+
+    // "Conversation only": the transcript overlay opens with the newest user
+    // message highlighted, reusing the old double-Esc backtrack picker.
+    app.show_rewind_message_picker(&mut tui, /*restore_files*/ false);
+    assert!(matches!(&app.overlay, Some(Overlay::Transcript(_))));
+    assert!(app.backtrack.overlay_preview_active);
+    assert_eq!(app.backtrack.nth_user_message, 1);
+    assert_eq!(
+        app.backtrack.confirm_mode,
+        crate::app_backtrack::BacktrackConfirmMode::Rewind {
+            restore_files: false
+        }
+    );
+
+    // Esc steps to the older message; Enter confirms the rewind fork without
+    // touching files.
+    app.handle_backtrack_overlay_event(
+        &mut tui,
+        &mut app_server,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE)),
+    )
+    .await?;
+    assert_eq!(app.backtrack.nth_user_message, 0);
+    assert!(
+        matches!(&app.overlay, Some(Overlay::Transcript(_))),
+        "overlay stays open while stepping"
+    );
+    app.handle_backtrack_overlay_event(
+        &mut tui,
+        &mut app_server,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE)),
+    )
+    .await?;
+    assert!(app.overlay.is_none(), "overlay closes on confirm");
+    assert_eq!(
+        app.backtrack.confirm_mode,
+        crate::app_backtrack::BacktrackConfirmMode::EditPrompt,
+        "state resets after confirm"
+    );
+    let events: Vec<AppEvent> = std::iter::from_fn(|| app_event_rx.try_recv().ok()).collect();
+    assert!(
+        events.iter().any(|event| matches!(
+            event,
+            AppEvent::ForkSessionForPromptEdit {
+                thread_id: event_thread_id,
+                nth_user_message: 0,
+                prompt,
+                restore_files: None,
+            } if *event_thread_id == thread_id && prompt.text == "first question"
+        )),
+        "should fork before the selected message: {events:?}"
+    );
+
+    // "Files and conversation": confirming the newest message also restores
+    // the snapshot taken for that turn.
+    app.show_rewind_message_picker(&mut tui, /*restore_files*/ true);
+    assert_eq!(
+        app.backtrack.confirm_mode,
+        crate::app_backtrack::BacktrackConfirmMode::Rewind {
+            restore_files: true
+        }
+    );
+    assert_eq!(app.backtrack.nth_user_message, 1);
+
+    // Snapshot the conversation's workspace so the combined rewind has file
+    // state to preview.
+    let workspace_file = workspace.path().join("notes.txt");
+    std::fs::write(&workspace_file, "v1")?;
+    crate::rewind::take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        &thread_id.to_string(),
+        "first question",
+        /*respect_gitignore*/ true,
+        crate::rewind::DEFAULT_MAX_SNAPSHOTS,
+    )?;
+    std::fs::write(&workspace_file, "v2")?;
+    crate::rewind::take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        &thread_id.to_string(),
+        "second question",
+        /*respect_gitignore*/ true,
+        crate::rewind::DEFAULT_MAX_SNAPSHOTS,
+    )?;
+    // Make the workspace differ from snapshot 2 so the confirmation preview
+    // has changes to report.
+    std::fs::write(&workspace_file, "v3")?;
+    app.handle_backtrack_overlay_event(
+        &mut tui,
+        &mut app_server,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE)),
+    )
+    .await?;
+    let events: Vec<AppEvent> = std::iter::from_fn(|| app_event_rx.try_recv().ok()).collect();
+    assert!(
+        !events
+            .iter()
+            .any(|event| matches!(event, AppEvent::ForkSessionForPromptEdit { .. })),
+        "the fork should wait for the confirmation preview: {events:?}"
+    );
+    // Confirm the preview; the fork event then carries the restore request.
+    app.chat_widget
+        .handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let events: Vec<AppEvent> = std::iter::from_fn(|| app_event_rx.try_recv().ok()).collect();
+    assert!(
+        events.iter().any(|event| matches!(
+            event,
+            AppEvent::ForkSessionForPromptEdit {
+                thread_id: event_thread_id,
+                nth_user_message: 1,
+                prompt,
+                restore_files: Some(request),
+            } if *event_thread_id == thread_id
+                && prompt.text == "second question"
+                && request.index == 2
+                && request.prompt == "second question"
+        )),
+        "should fork before the newest message after confirmation: {events:?}"
+    );
+
+    app_server.shutdown().await?;
+    Ok(())
+}
