+fn take_snapshot_captures_files_and_manifest() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "src/main.rs", b"fn main() {}");
+    write_file(workspace.path(), ".git/HEAD", b"ref");
+    write_file(workspace.path(), ".gitignore", b"target/\n");
