+#[test]
+fn snapshot_roundtrips_non_utf8_filenames() {
+    use std::ffi::OsStr;
+    use std::ffi::OsString;
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::ffi::OsStringExt;
+
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let raw_name: &[u8] = b"bad-\xff-name.txt";
+    let file = workspace.path().join(OsStr::from_bytes(raw_name));
+    fs::write(&file, b"v1").expect("write non-utf8 file");
+    take(codex_home.path(), workspace.path(), "one");
+
+    let manifest_path = thread_root(codex_home.path(), workspace.path(), TEST_THREAD)
+        .join("000001")
+        .join(MANIFEST_FILE_NAME);
+    let manifest: SnapshotManifest =
+        serde_json::from_str(&fs::read_to_string(&manifest_path).expect("read manifest"))
+            .expect("parse manifest");
+    assert_eq!(manifest.files.len(), 1);
+    assert!(
+        manifest.files[0].path_bytes.is_some(),
+        "a non-UTF-8 name must record its raw bytes"
+    );
+
+    fs::write(&file, b"v2").expect("modify");
+    let restored =
+        restore_snapshot(codex_home.path(), workspace.path(), TEST_THREAD, 1).expect("restore");
+    assert_eq!(restored, 1);
+    assert_eq!(fs::read(&file).expect("read"), b"v1");
+
+    let entries = fs::read_dir(workspace.path())
+        .expect("read workspace")
+        .flatten()
+        .map(|entry| entry.file_name())
+        .collect::<Vec<_>>();
+    assert_eq!(
+        entries,
+        vec![OsString::from_vec(raw_name.to_vec())],
+        "restore must not create a replacement-character sibling"
+    );
+}
