@@ -0,0 +1,1319 @@
+//! File snapshots for `/rewind`.
+//!
+//! Before each user turn the TUI snapshots the workspace so the user can roll
+//! back file changes. Each conversation owns an independent snapshot chain
+//! under `~/.codex/snapshots/<workspace-hash>/threads/<conversation-id>/`; a
+//! snapshot directory holds a `manifest.json` and the captured files under
+//! `files/`. The walk excludes `.git` and, by default, respects `.gitignore`
+//! files.
+//!
+//! Storage is content-addressed like a lightweight object database (no git
+//! involved): every unique file content is stored once under
+//! `<workspace>/objects/<sha256>` and each snapshot's `files/` entries are
+//! hardlinks into that object store. Unchanged files are linked from the
+//! previous snapshot without re-reading them, so repeated turns are cheap and
+//! every snapshot is self-contained for restore. Each conversation keeps its
+//! most recent snapshots (configurable via `rewind_max_snapshots`), and
+//! objects no longer referenced by any retained manifest are
+//! garbage-collected. A best-effort per-workspace lock prevents concurrent
+//! codEx instances from colliding on snapshot indices.
+
+use std::collections::BTreeSet;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs;
+use std::fs::OpenOptions;
+use std::io;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::UNIX_EPOCH;
+
+use ignore::WalkBuilder;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+
+/// Default maximum number of snapshots retained per conversation, matching
+/// the `rewind_max_snapshots` config default. Tests use this constant.
+#[cfg(test)]
+pub(crate) const DEFAULT_MAX_SNAPSHOTS: usize = 100;
+/// Current manifest format version.
+const MANIFEST_VERSION: u32 = 3;
+/// Older manifest versions that still deserialize: v2 predates the
+/// `respect_gitignore`, `skipped`, `prompt_hash`, and `path_bytes` fields.
+const LEGACY_MANIFEST_VERSION: u32 = 2;
+/// Prompt excerpt length stored in the manifest.
+const PROMPT_EXCERPT_CHARS: usize = 200;
+
+const MANIFEST_FILE_NAME: &str = "manifest.json";
+const FILES_DIR_NAME: &str = "files";
+const OBJECTS_DIR_NAME: &str = "objects";
+const THREADS_DIR_NAME: &str = "threads";
+const LOCK_DIR_NAME: &str = ".lock";
+const LOCK_PID_FILE: &str = "pid";
+const LOCK_STARTTIME_FILE: &str = "starttime";
+const TMP_FILE_PREFIX: &str = "tmp-";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct SnapshotFileEntry {
+    /// Path relative to the workspace root, rendered as UTF-8 for the JSON
+    /// manifest. Names that are not valid UTF-8 round-trip through
+    /// `path_bytes` instead.
+    pub(crate) path: String,
+    /// Hex-encoded raw path bytes, present only when `path`'s lossy rendering
+    /// would not round-trip (non-UTF-8 names).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub(crate) path_bytes: Option<String>,
+    pub(crate) size: u64,
+    pub(crate) mtime_ns: i128,
+    /// Object-store id (sha256 of the content); the snapshot's `files/` copy
+    /// is a hardlink to `objects/<id>`.
+    pub(crate) object: String,
+}
+
+/// A path that could not be captured at snapshot time (unreadable file, or a
+/// directory the walker could not descend into). Restore never deletes
+/// anything at or below such a path.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct SnapshotSkippedPath {
+    pub(crate) path: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub(crate) path_bytes: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct SnapshotManifest {
+    pub(crate) version: u32,
+    pub(crate) created_at: i64,
+    /// Excerpt of the user message that triggered this snapshot.
+    pub(crate) prompt: String,
+    /// sha256 (hex) of the full trimmed prompt, for exact message matching.
+    /// Missing in legacy manifests, which fall back to excerpt matching.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub(crate) prompt_hash: Option<String>,
+    pub(crate) files: Vec<SnapshotFileEntry>,
+    /// Paths skipped at snapshot time; restore leaves them untouched.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub(crate) skipped: Vec<SnapshotSkippedPath>,
+    /// Whether the snapshot walk respected `.gitignore`. Restore and preview
+    /// use this snapshot-time value so a config change between snapshot and
+    /// restore cannot delete files that were invisible at snapshot time.
+    /// Defaults to `true` for legacy manifests.
+    #[serde(default = "default_true")]
+    pub(crate) respect_gitignore: bool,
+}
+
+/// Metadata about a stored snapshot, used by the `/rewind` pickers.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct RewindSnapshotInfo {
+    /// Conversation (thread) this snapshot belongs to.
+    pub(crate) thread_id: String,
+    pub(crate) index: u64,
+    pub(crate) created_at: i64,
+    pub(crate) prompt: String,
+    /// Full-prompt hash for exact message matching; `None` for legacy
+    /// snapshots that only carry the excerpt.
+    pub(crate) prompt_hash: Option<String>,
+    /// Number of file paths that differ from the previous snapshot (added,
+    /// removed, or modified), shown in the snapshot picker.
+    pub(crate) changed_file_count: usize,
+}
+
+/// Result of a dry-run restore preview.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct RestorePreview {
+    /// Files that would be copied back (missing or different from the
+    /// snapshot).
+    pub(crate) restore_count: usize,
+    /// Files that would be deleted (present now but absent from the snapshot).
+    pub(crate) delete_count: usize,
+}
+
+fn default_true() -> bool {
+    true
+}
+
+/// Root directory holding snapshots for a workspace.
+pub(crate) fn snapshots_root(codex_home: &Path, cwd: &Path) -> PathBuf {
+    codex_home.join("snapshots").join(workspace_hash(cwd))
+}
+
+fn workspace_hash(cwd: &Path) -> String {
+    let canonical = fs::canonicalize(cwd).unwrap_or_else(|_| cwd.to_path_buf());
+    let digest = Sha256::digest(canonical.to_string_lossy().as_bytes());
+    let mut hex = String::with_capacity(16);
+    for byte in digest.iter().take(8) {
+        hex.push_str(&format!("{byte:02x}"));
+    }
+    hex
+}
+
+/// Directory holding one conversation's snapshot chain.
+fn snapshot_chain_dir(root: &Path, thread_id: &str) -> PathBuf {
+    root.join(THREADS_DIR_NAME)
+        .join(sanitize_thread_id(thread_id))
+}
+
+/// Conversation ids come from thread UUIDs; keep only filesystem-safe
+/// characters so they can be used as directory names. Non-conforming ids are
+/// hex-encoded so distinct ids never collide on the same directory.
+fn sanitize_thread_id(thread_id: &str) -> String {
+    let sanitized: String = thread_id
+        .chars()
+        .map(|character| {
+            if character.is_ascii_alphanumeric() || matches!(character, '-' | '_') {
+                character
+            } else {
+                '_'
+            }
+        })
+        .collect();
+    if sanitized == thread_id {
+        sanitized
+    } else {
+        format!("hex_{}", hex_encode(thread_id.as_bytes()))
+    }
+}
+
+/// Takes a snapshot of `cwd` for a conversation before a user turn.
+///
+/// The snapshot directory is numbered with the next unused index in the
+/// conversation's chain. Changed files are stored once in the workspace
+/// object store and linked into the snapshot's `files/` directory; files
+/// unchanged since the previous snapshot are linked from the previous
+/// snapshot without being re-read. Returns the path of the new snapshot
+/// directory.
+#[cfg(test)]
+pub(crate) fn take_snapshot(
+    codex_home: &Path,
+    cwd: &Path,
+    thread_id: &str,
+    prompt: &str,
+    respect_gitignore: bool,
+    max_snapshots: usize,
+) -> io::Result<PathBuf> {
+    take_snapshot_with_skipped(
+        codex_home,
+        cwd,
+        thread_id,
+        prompt,
+        respect_gitignore,
+        max_snapshots,
+    )
+    .map(|(snapshot_dir, _skipped)| snapshot_dir)
+}
+
+/// Takes a snapshot and additionally reports which paths were skipped
+/// because they could not be read. Callers surface these to the user so a
+/// silently incomplete snapshot never passes unnoticed.
+pub(crate) fn take_snapshot_with_skipped(
+    codex_home: &Path,
+    cwd: &Path,
+    thread_id: &str,
+    prompt: &str,
+    respect_gitignore: bool,
+    max_snapshots: usize,
+) -> io::Result<(PathBuf, Vec<PathBuf>)> {
+    let root = snapshots_root(codex_home, cwd);
+    fs::create_dir_all(&root)?;
+    let _lock = WorkspaceLock::acquire(&root)?;
+    let chain_root = snapshot_chain_dir(&root, thread_id);
+    fs::create_dir_all(&chain_root)?;
+    let objects_dir = root.join(OBJECTS_DIR_NAME);
+    fs::create_dir_all(&objects_dir)?;
+
+    let index = next_snapshot_index(&chain_root)?;
+    let snapshot_dir = chain_root.join(format!("{index:06}"));
+    let files_dir = snapshot_dir.join(FILES_DIR_NAME);
+    fs::create_dir_all(&files_dir)?;
+
+    // The fast path reuses the newest earlier snapshot: this conversation's
+    // when one exists, otherwise the newest snapshot of any conversation in
+    // this workspace, so resumed/forked conversations do not re-hash files
+    // that are unchanged on disk.
+    let previous =
+        previous_snapshot(&chain_root, index).or_else(|| newest_workspace_snapshot(&root));
+    let previous_files = previous
+        .as_ref()
+        .map(|(_, manifest)| {
+            manifest
+                .files
+                .iter()
+                .map(|entry| {
+                    (
+                        entry_path(entry),
+                        (entry.size, entry.mtime_ns, entry.object.clone()),
+                    )
+                })
+                .collect::<HashMap<_, _>>()
+        })
+        .unwrap_or_default();
+
+    let mut skipped = Vec::new();
+    let mut skipped_paths = Vec::new();
+    // Walk and manifest writing happen inside a closure so a failure can
+    // clean up the partially written snapshot directory before returning.
+    // Orphaned objects from the failed walk are reclaimed by the next
+    // garbage-collection pass.
+    let snapshot_result = (|| -> io::Result<()> {
+        let mut entries = Vec::new();
+        let snapshot_root = root.clone();
+        for walk_entry in workspace_walker(cwd, respect_gitignore, Some(&snapshot_root)) {
+            let entry = match walk_entry {
+                Ok(entry) => entry,
+                Err(err) => {
+                    // A directory we could not enumerate hides unknown files,
+                    // so a partial snapshot could later delete them. Fail the
+                    // whole snapshot instead of recording an incomplete one.
+                    return Err(io::Error::other(err));
+                }
+            };
+            if !entry
+                .file_type()
+                .is_some_and(|file_type| file_type.is_file())
+            {
+                continue;
+            }
+            let path = entry.path();
+            let relative = path
+                .strip_prefix(cwd)
+                .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+            if is_ignored_path(relative) {
+                continue;
+            }
+            // Unreadable or vanishing files are skipped instead of failing
+            // the whole snapshot; a later restore leaves them untouched.
+            let metadata = match entry.metadata() {
+                Ok(metadata) => metadata,
+                Err(_) => {
+                    record_skip(&mut skipped, &mut skipped_paths, relative);
+                    continue;
+                }
+            };
+            let size = metadata.len();
+            let mtime_ns = match mtime_nanos(&metadata) {
+                Ok(mtime) => mtime,
+                Err(_) => {
+                    record_skip(&mut skipped, &mut skipped_paths, relative);
+                    continue;
+                }
+            };
+            let dest = files_dir.join(relative);
+            if let Some(parent) = dest.parent() {
+                fs::create_dir_all(parent)?;
+            }
+
+            // Fast path: unchanged since the reference snapshot, so its
+            // physical copy (an object hardlink) can be reused without
+            // hashing the file. Same size and mtime are treated as unchanged.
+            if let Some((previous_size, previous_mtime, previous_object)) =
+                previous_files.get(relative)
+                && *previous_size == size
+                && *previous_mtime == mtime_ns
+                && let Some((previous_dir, _)) = &previous
+                && previous_dir.join(FILES_DIR_NAME).join(relative).is_file()
+            {
+                let previous_copy = previous_dir.join(FILES_DIR_NAME).join(relative);
+                link_or_copy(&previous_copy, &dest)?;
+                entries.push(SnapshotFileEntry {
+                    path: relative.to_string_lossy().into_owned(),
+                    path_bytes: raw_path_bytes(relative),
+                    size,
+                    mtime_ns,
+                    object: previous_object.clone(),
+                });
+                continue;
+            }
+
+            // Changed or new: store the content once in the object store and
+            // link it. Identical content from any earlier snapshot reuses the
+            // same object.
+            let object_id = match hash_file(path) {
+                Ok(object_id) => object_id,
+                Err(_) => {
+                    record_skip(&mut skipped, &mut skipped_paths, relative);
+                    continue;
+                }
+            };
+            let object_path = objects_dir.join(&object_id);
+            if !object_path.is_file() {
+                publish_object(path, &object_path)?;
+            }
+            link_or_copy(&object_path, &dest)?;
+            entries.push(SnapshotFileEntry {
+                path: relative.to_string_lossy().into_owned(),
+                path_bytes: raw_path_bytes(relative),
+                size,
+                mtime_ns,
+                object: object_id,
+            });
+        }
+        entries.sort_by(|a, b| a.path.cmp(&b.path));
+
+        let manifest = SnapshotManifest {
+            version: MANIFEST_VERSION,
+            created_at: now_unix_seconds(),
+            prompt: prompt_excerpt(prompt),
+            prompt_hash: Some(prompt_hash_hex(prompt)),
+            files: entries,
+            skipped,
+            respect_gitignore,
+        };
+        write_manifest(&snapshot_dir, &manifest)
+    })();
+    if let Err(err) = snapshot_result {
+        let _ = fs::remove_dir_all(&snapshot_dir);
+        return Err(err);
+    }
+    prune_all_chains(&root, max_snapshots)?;
+    Ok((snapshot_dir, skipped_paths))
+}
+
+/// Records an unreadable path in both the manifest list and the caller-facing
+/// list of skipped paths.
+fn record_skip(
+    skipped: &mut Vec<SnapshotSkippedPath>,
+    skipped_paths: &mut Vec<PathBuf>,
+    relative: &Path,
+) {
+    skipped.push(skipped_path(relative));
+    skipped_paths.push(relative.to_path_buf());
+}
+
+/// Lists one conversation's snapshot chain, oldest first.
+///
+/// Each entry reports how many file paths changed since the previous snapshot
+/// so the picker can summarize each turn's file impact.
+pub(crate) fn list_snapshots(
+    codex_home: &Path,
+    cwd: &Path,
+    thread_id: &str,
+) -> Vec<RewindSnapshotInfo> {
+    let root = snapshots_root(codex_home, cwd);
+    list_chain_snapshots(&snapshot_chain_dir(&root, thread_id), thread_id)
+}
+
+/// Lists every snapshot in the workspace across all conversation chains,
+/// oldest first by creation time. Used by the Files-only picker.
+pub(crate) fn list_workspace_snapshots(codex_home: &Path, cwd: &Path) -> Vec<RewindSnapshotInfo> {
+    let root = snapshots_root(codex_home, cwd);
+    let Ok(threads_dir) = fs::read_dir(root.join(THREADS_DIR_NAME)) else {
+        return Vec::new();
+    };
+    let mut snapshots = Vec::new();
+    for entry in threads_dir.flatten() {
+        let Some(name) = entry.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if !entry.path().is_dir() {
+            continue;
+        }
+        snapshots.extend(list_chain_snapshots(&entry.path(), &name));
+    }
+    snapshots.sort_by_key(|snapshot| snapshot.created_at);
+    snapshots
+}
+
+fn list_chain_snapshots(chain_root: &Path, thread_id: &str) -> Vec<RewindSnapshotInfo> {
+    let Ok(read_dir) = fs::read_dir(chain_root) else {
+        return Vec::new();
+    };
+    let mut manifests = Vec::new();
+    for entry in read_dir.flatten() {
+        let Some(index) = entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.parse::<u64>().ok())
+        else {
+            continue;
+        };
+        // Skip directories without a usable manifest (e.g. interrupted
+        // snapshots that were never cleaned up).
+        let Some(manifest) = read_manifest(&entry.path()).ok().flatten() else {
+            continue;
+        };
+        manifests.push((index, manifest));
+    }
+    manifests.sort_by_key(|(index, _)| *index);
+
+    let mut snapshots = Vec::with_capacity(manifests.len());
+    let mut previous_files: Option<HashMap<PathBuf, (u64, i128)>> = None;
+    for (index, manifest) in manifests {
+        let files = manifest
+            .files
+            .iter()
+            .map(|entry| (entry_path(entry), (entry.size, entry.mtime_ns)))
+            .collect::<HashMap<_, _>>();
+        let changed_file_count = match &previous_files {
+            None => files.len(),
+            Some(previous) => {
+                let mut changed = files
+                    .iter()
+                    .filter(|(path, current)| previous.get(*path) != Some(current))
+                    .count();
+                changed += previous
+                    .keys()
+                    .filter(|path| !files.contains_key(*path))
+                    .count();
+                changed
+            }
+        };
+        previous_files = Some(files);
+        snapshots.push(RewindSnapshotInfo {
+            thread_id: thread_id.to_string(),
+            index,
+            created_at: manifest.created_at,
+            prompt: manifest.prompt,
+            prompt_hash: manifest.prompt_hash,
+            changed_file_count,
+        });
+    }
+    snapshots
+}
+
+/// Restores the workspace to the state captured in snapshot `index` of a
+/// conversation's chain.
+///
+/// Files recorded in the snapshot are copied back (overwriting current
+/// content) and files present in the workspace but absent from the snapshot
+/// are deleted. Returns the number of files restored. Content-addressed
+/// snapshots hold every file as an object hardlink, so restore is direct;
+/// when a physical copy is missing the restore fails with the paths listed
+/// instead of silently leaving the current content in place. Restored files
+/// get their original mtime back so the incremental fast path keeps working
+/// after a restore.
+///
+/// The whole restore is preflighted before anything is touched: missing
+/// snapshot content, unsafe recorded paths, a directory in the way, or a
+/// symbolic link above a target fail the restore up front. Per-file writes go
+/// through a temporary file and rename, so they never follow a symbolic link
+/// at the target path and can replace read-only files. The delete set is
+/// computed with the same rules as [`preview_restore`] (current `.gitignore`
+/// contents, snapshot-time respect setting) so the confirmation count always
+/// matches what this restore deletes.
+pub(crate) fn restore_snapshot(
+    codex_home: &Path,
+    cwd: &Path,
+    thread_id: &str,
+    index: u64,
+) -> io::Result<usize> {
+    let root = snapshots_root(codex_home, cwd);
+    let _lock = WorkspaceLock::acquire(&root)?;
+    let chain_root = snapshot_chain_dir(&root, thread_id);
+    let snapshot_dir = chain_root.join(format!("{index:06}"));
+    let manifest = read_manifest(&snapshot_dir)?.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("snapshot {index} does not exist"),
+        )
+    })?;
+
+    // Preflight before any mutation.
+    let mut problems = Vec::new();
+    for entry in &manifest.files {
+        let relative = entry_path(entry);
+        if let Err(err) = check_restore_path(&relative) {
+            problems.push(format!("{}: {err}", entry.path));
+            continue;
+        }
+        let source = snapshot_dir.join(FILES_DIR_NAME).join(&relative);
+        if !source.is_file() {
+            problems.push(format!("{}: snapshot content is missing", entry.path));
+            continue;
+        }
+        let target = cwd.join(&relative);
+        if let Some(link) = symlinked_ancestor(cwd, &relative) {
+            problems.push(format!(
+                "{}: refuses to write through symbolic link {}",
+                entry.path,
+                link.display()
+            ));
+        } else if target.is_dir() {
+            problems.push(format!("{}: target is a directory", entry.path));
+        }
+    }
+    if !problems.is_empty() {
+        let mut message = format!("cannot restore snapshot {index}:");
+        for problem in problems.iter().take(5) {
+            message.push('\n');
+            message.push_str(problem);
+        }
+        if problems.len() > 5 {
+            message.push_str(&format!("\n...and {} more", problems.len() - 5));
+        }
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, message));
+    }
+
+    // Capture the delete set before the copy phase (which rewrites
+    // `.gitignore`), so the rules match the confirmation preview exactly.
+    let delete_candidates = delete_candidate_paths(cwd, &root, &manifest);
+
+    let mut restored = 0;
+    for (sequence, entry) in manifest.files.iter().enumerate() {
+        let relative = entry_path(entry);
+        let source = snapshot_dir.join(FILES_DIR_NAME).join(&relative);
+        let target = cwd.join(&relative);
+        if let Some(parent) = target.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        copy_over_atomic(&source, &target, sequence)?;
+        restore_mtime(&target, entry.mtime_ns);
+        restored += 1;
+    }
+
+    for candidate in delete_candidates {
+        match fs::remove_file(&candidate) {
+            Ok(()) => {}
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+            Err(err) => return Err(err),
+        }
+    }
+
+    Ok(restored)
+}
+
+/// Computes the workspace files a restore would delete: files present now
+/// that the snapshot neither recorded nor skipped, using the snapshot-time
+/// `.gitignore` setting against the current workspace's `.gitignore` rules.
+fn delete_candidate_paths(cwd: &Path, root: &Path, manifest: &SnapshotManifest) -> Vec<PathBuf> {
+    let manifest_paths = manifest
+        .files
+        .iter()
+        .map(|entry| entry_path(entry))
+        .collect::<BTreeSet<_>>();
+    let skipped_prefixes = manifest
+        .skipped
+        .iter()
+        .map(skipped_path_to_pathbuf)
+        .collect::<Vec<_>>();
+
+    let mut candidates = Vec::new();
+    for entry in workspace_walker(cwd, manifest.respect_gitignore, Some(root)) {
+        let Ok(entry) = entry else {
+            continue;
+        };
+        if !entry
+            .file_type()
+            .is_some_and(|file_type| file_type.is_file())
+        {
+            continue;
+        }
+        let Ok(relative) = entry.path().strip_prefix(cwd) else {
+            continue;
+        };
+        if is_ignored_path(relative) || manifest_paths.contains(relative) {
+            continue;
+        }
+        if skipped_prefixes
+            .iter()
+            .any(|prefix| relative.starts_with(prefix))
+        {
+            continue;
+        }
+        candidates.push(entry.path().to_path_buf());
+    }
+    candidates
+}
+
+/// Dry-run preview of restoring snapshot `index`: counts how many files would
+/// be copied back and how many would be deleted, without touching the
+/// workspace. Used to confirm a rewind before applying it. The delete count
+/// is computed with exactly the same rules as [`restore_snapshot`].
+pub(crate) fn preview_restore(
+    codex_home: &Path,
+    cwd: &Path,
+    thread_id: &str,
+    index: u64,
+) -> io::Result<RestorePreview> {
+    let root = snapshots_root(codex_home, cwd);
+    let chain_root = snapshot_chain_dir(&root, thread_id);
+    let snapshot_dir = chain_root.join(format!("{index:06}"));
+    let manifest = read_manifest(&snapshot_dir)?.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("snapshot {index} does not exist"),
+        )
+    })?;
+
+    let mut restore_count = 0;
+    for entry in &manifest.files {
+        let target = cwd.join(entry_path(entry));
+        let differs = match fs::metadata(&target) {
+            Ok(metadata) => {
+                let same_size = metadata.len() == entry.size;
+                let same_mtime = mtime_nanos(&metadata)
+                    .map(|mtime| mtime == entry.mtime_ns)
+                    .unwrap_or(false);
+                !(same_size && same_mtime)
+            }
+            Err(_) => true,
+        };
+        if differs {
+            restore_count += 1;
+        }
+    }
+
+    let delete_count = delete_candidate_paths(cwd, &root, &manifest).len();
+    Ok(RestorePreview {
+        restore_count,
+        delete_count,
+    })
+}
+
+/// Copies `source` over `target` atomically: content is written to a fresh
+/// temporary file next to the target and renamed into place. The rename
+/// replaces a symbolic link at the target instead of writing through it, and
+/// replaces read-only files without an open-for-write on the target itself.
+fn copy_over_atomic(source: &Path, target: &Path, sequence: usize) -> io::Result<()> {
+    let target_dir = target.parent().ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "restore target has no parent directory",
+        )
+    })?;
+    let file_name = target
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("rewind-file");
+    let tmp_path = target_dir.join(format!(
+        ".{file_name}.codEx-rewind-{}-{sequence}",
+        std::process::id()
+    ));
+    let result = (|| -> io::Result<()> {
+        let mut reader = fs::File::open(source)?;
+        let permissions = reader.metadata()?.permissions();
+        let mut writer = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&tmp_path)?;
+        io::copy(&mut reader, &mut writer)?;
+        drop(writer);
+        fs::set_permissions(&tmp_path, permissions)?;
+        fs::rename(&tmp_path, target)?;
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(&tmp_path);
+    }
+    result
+}
+
+fn workspace_walker(
+    cwd: &Path,
+    respect_gitignore: bool,
+    exclude_dir: Option<&Path>,
+) -> ignore::Walk {
+    let mut builder = WalkBuilder::new(cwd);
+    builder
+        .hidden(false)
+        .follow_links(false)
+        .git_ignore(respect_gitignore)
+        .git_exclude(false)
+        .git_global(false)
+        .require_git(false);
+    if let Some(exclude_dir) = exclude_dir {
+        let exclude = exclude_dir.to_path_buf();
+        builder.filter_entry(move |entry| {
+            let path = entry.path();
+            path == exclude || !path.starts_with(&exclude)
+        });
+    }
+    builder.build()
+}
+
+fn is_ignored_path(relative: &Path) -> bool {
+    relative.starts_with(".git")
+}
+
+fn next_snapshot_index(chain_root: &Path) -> io::Result<u64> {
+    let max_index = fs::read_dir(chain_root)?
+        .flatten()
+        .filter_map(|entry| {
+            entry
+                .file_name()
+                .to_str()
+                .and_then(|name| name.parse::<u64>().ok())
+        })
+        .max()
+        .unwrap_or(0);
+    Ok(max_index.saturating_add(1))
+}
+
+/// Returns the newest snapshot directory and manifest below `current_index`.
+fn previous_snapshot(chain_root: &Path, current_index: u64) -> Option<(PathBuf, SnapshotManifest)> {
+    let mut best: Option<(u64, PathBuf, SnapshotManifest)> = None;
+    for entry in fs::read_dir(chain_root).ok()?.flatten() {
+        let Some(index) = entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.parse::<u64>().ok())
+        else {
+            continue;
+        };
+        if index >= current_index {
+            continue;
+        }
+        let Some(manifest) = read_manifest(&entry.path()).ok().flatten() else {
+            continue;
+        };
+        if best
+            .as_ref()
+            .map_or(true, |(best_index, _, _)| index > *best_index)
+        {
+            best = Some((index, entry.path(), manifest));
+        }
+    }
+    best.map(|(_, directory, manifest)| (directory, manifest))
+}
+
+/// Returns the newest snapshot (by `created_at`) from any conversation chain
+/// in the workspace, used to seed the incremental fast path for conversations
+/// that have no earlier snapshot of their own.
+fn newest_workspace_snapshot(root: &Path) -> Option<(PathBuf, SnapshotManifest)> {
+    let threads_dir = root.join(THREADS_DIR_NAME);
+    let mut best: Option<(i64, PathBuf, SnapshotManifest)> = None;
+    for entry in fs::read_dir(&threads_dir).ok()?.flatten() {
+        if !entry.path().is_dir() {
+            continue;
+        }
+        let Some((directory, manifest)) = previous_snapshot(&entry.path(), u64::MAX) else {
+            continue;
+        };
+        if best
+            .as_ref()
+            .map_or(true, |(created_at, _, _)| manifest.created_at > *created_at)
+        {
+            best = Some((manifest.created_at, directory, manifest));
+        }
+    }
+    best.map(|(_, directory, manifest)| (directory, manifest))
+}
+
+fn read_manifest(snapshot_dir: &Path) -> io::Result<Option<SnapshotManifest>> {
+    let manifest_path = snapshot_dir.join(MANIFEST_FILE_NAME);
+    if !manifest_path.is_file() {
+        return Ok(None);
+    }
+    let contents = fs::read_to_string(&manifest_path)?;
+    let manifest: SnapshotManifest = serde_json::from_str(&contents)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+    if manifest.version != MANIFEST_VERSION && manifest.version != LEGACY_MANIFEST_VERSION {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("unsupported snapshot manifest version {}", manifest.version),
+        ));
+    }
+    Ok(Some(manifest))
+}
+
+fn write_manifest(snapshot_dir: &Path, manifest: &SnapshotManifest) -> io::Result<()> {
+    let contents = serde_json::to_string_pretty(manifest)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+    // Write through a temporary file and rename so a crash never leaves a
+    // truncated manifest behind.
+    let final_path = snapshot_dir.join(MANIFEST_FILE_NAME);
+    let tmp_path = snapshot_dir.join(format!("{MANIFEST_FILE_NAME}.tmp"));
+    match fs::write(&tmp_path, contents) {
+        Ok(()) => match fs::rename(&tmp_path, &final_path) {
+            Ok(()) => Ok(()),
+            Err(err) => {
+                let _ = fs::remove_file(&tmp_path);
+                Err(err)
+            }
+        },
+        Err(err) => {
+            let _ = fs::remove_file(&tmp_path);
+            Err(err)
+        }
+    }
+}
+
+/// Prunes a snapshot chain down to `max_snapshots` retained snapshots and
+/// removes interrupted snapshot directories (no manifest) that could never
+/// be restored.
+fn prune_chain(chain_root: &Path, max_snapshots: usize) -> io::Result<()> {
+    let mut valid = Vec::new();
+    let mut interrupted = Vec::new();
+    for entry in fs::read_dir(chain_root)?.flatten() {
+        let Some(index) = entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.parse::<u64>().ok())
+        else {
+            continue;
+        };
+        if !entry.path().is_dir() {
+            continue;
+        }
+        match read_manifest(&entry.path()) {
+            Ok(Some(_)) => valid.push(index),
+            Ok(None) => interrupted.push(index),
+            // A corrupt manifest may be repairable by hand; keep the
+            // directory rather than silently destroying its contents.
+            Err(_) => {}
+        }
+    }
+    valid.sort_unstable();
+    let overflow = valid.len().saturating_sub(max_snapshots);
+    for index in valid.into_iter().take(overflow) {
+        let dir = chain_root.join(format!("{index:06}"));
+        fs::remove_dir_all(&dir)?;
+    }
+    for index in interrupted {
+        let dir = chain_root.join(format!("{index:06}"));
+        fs::remove_dir_all(&dir)?;
+    }
+    Ok(())
+}
+
+/// Prunes every conversation chain, then garbage-collects objects no longer
+/// referenced by any retained manifest.
+fn prune_all_chains(root: &Path, max_snapshots: usize) -> io::Result<()> {
+    if let Ok(threads_dir) = fs::read_dir(root.join(THREADS_DIR_NAME)) {
+        for entry in threads_dir.flatten() {
+            if entry.path().is_dir() {
+                prune_chain(&entry.path(), max_snapshots)?;
+            }
+        }
+    }
+    garbage_collect_objects(root)
+}
+
+/// Removes object-store entries no longer referenced by any retained
+/// snapshot manifest, plus leftover temporary files from interrupted writes.
+fn garbage_collect_objects(root: &Path) -> io::Result<()> {
+    let objects_dir = root.join(OBJECTS_DIR_NAME);
+    let mut referenced = HashSet::new();
+    let mut collect_chain = |chain_root: &Path| -> io::Result<()> {
+        for entry in fs::read_dir(chain_root)?.flatten() {
+            let Some(_index) = entry
+                .file_name()
+                .to_str()
+                .and_then(|name| name.parse::<u64>().ok())
+            else {
+                continue;
+            };
+            let Ok(Some(manifest)) = read_manifest(&entry.path()) else {
+                continue;
+            };
+            for file in manifest.files {
+                referenced.insert(file.object);
+            }
+        }
+        Ok(())
+    };
+    if let Ok(threads_dir) = fs::read_dir(root.join(THREADS_DIR_NAME)) {
+        for entry in threads_dir.flatten() {
+            if entry.path().is_dir() {
+                collect_chain(&entry.path())?;
+            }
+        }
+    }
+
+    let Ok(read_dir) = fs::read_dir(&objects_dir) else {
+        return Ok(());
+    };
+    for entry in read_dir.flatten() {
+        let Ok(file_type) = entry.file_type() else {
+            continue;
+        };
+        if !file_type.is_file() {
+            continue;
+        }
+        let Some(name) = entry.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if name.starts_with(TMP_FILE_PREFIX) || !referenced.contains(&name) {
+            let _ = fs::remove_file(entry.path());
+        }
+    }
+    Ok(())
+}
+
+/// Best-effort per-workspace lock guarding snapshot mutations.
+///
+/// Implemented as an exclusively created directory so concurrent codEx
+/// instances cannot collide on snapshot indices. The owner's PID and process
+/// start time are recorded; a lock whose PID no longer exists, or whose
+/// start time no longer matches (PID reuse), is treated as stale and taken
+/// over.
+struct WorkspaceLock {
+    directory: PathBuf,
+}
+
+impl WorkspaceLock {
+    fn acquire(root: &Path) -> io::Result<Self> {
+        fs::create_dir_all(root)?;
+        let directory = root.join(LOCK_DIR_NAME);
+        match fs::create_dir(&directory) {
+            Ok(()) => {
+                write_lock_identity(&directory)?;
+                return Ok(Self { directory });
+            }
+            Err(err) if err.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(err) => return Err(err),
+        }
+        if lock_owner_alive(&directory) {
+            return Err(io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "another codEx instance holds the rewind snapshot lock for this workspace",
+            ));
+        }
+        // The previous owner is gone; take the lock over.
+        fs::remove_dir_all(&directory)?;
+        fs::create_dir(&directory)?;
+        write_lock_identity(&directory)?;
+        Ok(Self { directory })
+    }
+}
+
+/// Records the owning PID and its process start time. A failed write leaves a
+/// lock that other instances would consider stale, so it must remove the lock
+/// directory and fail the acquisition instead.
+fn write_lock_identity(directory: &Path) -> io::Result<()> {
+    let pid = std::process::id();
+    if let Err(err) = fs::write(directory.join(LOCK_PID_FILE), pid.to_string()) {
+        let _ = fs::remove_dir_all(directory);
+        return Err(err);
+    }
+    if let Some(start_time) = process_start_time(pid) {
+        if let Err(err) = fs::write(directory.join(LOCK_STARTTIME_FILE), start_time.to_string()) {
+            let _ = fs::remove_dir_all(directory);
+            return Err(err);
+        }
+    }
+    Ok(())
+}
+
+fn lock_owner_alive(lock_directory: &Path) -> bool {
+    let Ok(pid_text) = fs::read_to_string(lock_directory.join(LOCK_PID_FILE)) else {
+        return false;
+    };
+    let Ok(pid) = pid_text.trim().parse::<u32>() else {
+        return false;
+    };
+    if pid == std::process::id() {
+        return true;
+    }
+    let proc_dir = Path::new("/proc").join(pid.to_string());
+    if !proc_dir.is_dir() {
+        return false;
+    }
+    // The PID still exists. If we recorded the owner's start time, require it
+    // to match so a recycled PID cannot keep a dead instance's lock alive.
+    let Ok(recorded_text) = fs::read_to_string(lock_directory.join(LOCK_STARTTIME_FILE)) else {
+        return true;
+    };
+    let Ok(recorded) = recorded_text.trim().parse::<u64>() else {
+        return true;
+    };
+    match process_start_time(pid) {
+        Some(current) => current == recorded,
+        // Cannot verify; assume alive rather than stealing a live lock.
+        None => true,
+    }
+}
+
+/// Reads the process start time (clock ticks since boot) from
+/// `/proc/<pid>/stat`; field 22 in the field list.
+fn process_start_time(pid: u32) -> Option<u64> {
+    let stat = fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    let fields_after_comm = stat.rsplit_once(')')?.1;
+    fields_after_comm
+        .split_whitespace()
+        .nth(19)
+        .and_then(|token| token.parse().ok())
+}
+
+impl Drop for WorkspaceLock {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.directory);
+    }
+}
+
+/// Hardlinks `source` into `dest`, falling back to a copy on filesystems that
+/// do not support hardlinks.
+fn link_or_copy(source: &Path, dest: &Path) -> io::Result<()> {
+    match fs::hard_link(source, dest) {
+        Ok(()) => Ok(()),
+        Err(_) => fs::copy(source, dest).map(|_| ()),
+    }
+}
+
+/// Publishes a file into the object store atomically: it is written to a
+/// temporary name first and renamed into place, so readers never observe a
+/// partially written object.
+fn publish_object(source: &Path, object_path: &Path) -> io::Result<()> {
+    let objects_dir = object_path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "object path has no parent"))?;
+    let tmp_path = objects_dir.join(format!(
+        "{TMP_FILE_PREFIX}{}-{}",
+        std::process::id(),
+        object_path
+            .file_name()
+            .and_then(|name| name.to_str())
+            .unwrap_or_default()
+    ));
+    match fs::copy(source, &tmp_path) {
+        Ok(_) => match fs::rename(&tmp_path, object_path) {
+            Ok(()) => Ok(()),
+            Err(err) => {
+                let _ = fs::remove_file(&tmp_path);
+                Err(err)
+            }
+        },
+        Err(err) => {
+            let _ = fs::remove_file(&tmp_path);
+            Err(err)
+        }
+    }
+}
+
+/// Hashes a file's content (sha256) for the object store.
+fn hash_file(path: &Path) -> io::Result<String> {
+    let mut file = fs::File::open(path)?;
+    let mut hasher = Sha256::new();
+    io::copy(&mut file, &mut hasher)?;
+    Ok(hex_encode(&hasher.finalize()))
+}
+
+fn hex_encode(bytes: &[u8]) -> String {
+    let mut hex = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        hex.push_str(&format!("{byte:02x}"));
+    }
+    hex
+}
+
+fn hex_decode(hex: &str) -> Option<Vec<u8>> {
+    if hex.len() % 2 != 0 {
+        return None;
+    }
+    (0..hex.len())
+        .step_by(2)
+        .map(|index| u8::from_str_radix(&hex[index..index + 2], 16).ok())
+        .collect()
+}
+
+/// Hex-encodes a path's raw bytes when its lossy UTF-8 rendering would not
+/// round-trip, so non-UTF-8 file names survive the JSON manifest.
+fn raw_path_bytes(path: &Path) -> Option<String> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        let raw = path.as_os_str().as_bytes();
+        if std::str::from_utf8(raw).is_err() {
+            return Some(hex_encode(raw));
+        }
+    }
+    None
+}
+
+fn skipped_path(path: &Path) -> SnapshotSkippedPath {
+    SnapshotSkippedPath {
+        path: path.to_string_lossy().into_owned(),
+        path_bytes: raw_path_bytes(path),
+    }
+}
+
+fn entry_path(entry: &SnapshotFileEntry) -> PathBuf {
+    path_from_bytes(&entry.path, entry.path_bytes.as_deref())
+}
+
+fn skipped_path_to_pathbuf(skipped: &SnapshotSkippedPath) -> PathBuf {
+    path_from_bytes(&skipped.path, skipped.path_bytes.as_deref())
+}
+
+fn path_from_bytes(fallback: &str, path_bytes: Option<&str>) -> PathBuf {
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStringExt;
+        if let Some(encoded) = path_bytes
+            && let Some(bytes) = hex_decode(encoded)
+        {
+            return PathBuf::from(std::ffi::OsString::from_vec(bytes));
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = path_bytes;
+    }
+    PathBuf::from(fallback)
+}
+
+/// Rejects recorded paths that could escape the workspace (`..`, absolute
+/// paths) when a hand-edited or corrupted manifest is restored.
+fn check_restore_path(relative: &Path) -> io::Result<()> {
+    if relative.is_absolute()
+        || relative
+            .components()
+            .any(|component| !matches!(component, Component::Normal(_)))
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("unsafe path recorded in snapshot: {}", relative.display()),
+        ));
+    }
+    Ok(())
+}
+
+/// Returns the first ancestor of `cwd.join(relative)` (excluding the final
+/// component) that is a symbolic link, if any. Restoring through such a link
+/// would write outside the workspace.
+fn symlinked_ancestor(base: &Path, relative: &Path) -> Option<PathBuf> {
+    let parent = relative.parent()?;
+    let mut current = base.to_path_buf();
+    for component in parent.components() {
+        current.push(component.as_os_str());
+        if fs::symlink_metadata(&current).is_ok_and(|metadata| metadata.file_type().is_symlink()) {
+            return Some(current);
+        }
+    }
+    None
+}
+
+/// Restores a file's modification time from the snapshot manifest so the
+/// size+mtime fast path still recognizes the file as unchanged after a
+/// restore. Best effort: read-only files may not be openable for writing.
+fn restore_mtime(target: &Path, mtime_ns: i128) {
+    let Some(time) = system_time_from_nanos(mtime_ns) else {
+        return;
+    };
+    if let Ok(file) = OpenOptions::new().write(true).open(target) {
+        let _ = file.set_modified(time);
+    }
+}
+
+fn system_time_from_nanos(mtime_ns: i128) -> Option<std::time::SystemTime> {
+    let seconds = mtime_ns.div_euclid(1_000_000_000);
+    let nanos = mtime_ns.rem_euclid(1_000_000_000);
+    u64::try_from(seconds)
+        .ok()
+        .map(|secs| UNIX_EPOCH + std::time::Duration::new(secs, nanos as u32))
+}
+
+fn mtime_nanos(metadata: &fs::Metadata) -> io::Result<i128> {
+    let modified = metadata.modified()?;
+    let duration = modified
+        .duration_since(UNIX_EPOCH)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+    Ok(i128::from(duration.as_secs()) * 1_000_000_000 + i128::from(duration.subsec_nanos()))
+}
+
+fn now_unix_seconds() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_secs() as i64)
+        .unwrap_or_default()
+}
+
+pub(crate) fn prompt_excerpt(prompt: &str) -> String {
+    let trimmed = prompt.trim();
+    if trimmed.is_empty() {
+        return "(attachment)".to_string();
+    }
+    let mut excerpt = trimmed
+        .chars()
+        .take(PROMPT_EXCERPT_CHARS)
+        .collect::<String>();
+    excerpt.push_str(if trimmed.chars().count() > PROMPT_EXCERPT_CHARS {
+        "…"
+    } else {
+        ""
+    });
+    excerpt
+}
+
+fn prompt_hash_hex(prompt: &str) -> String {
+    let digest = Sha256::digest(prompt.trim().as_bytes());
+    hex_encode(&digest)
+}
+
+/// Whether a snapshot carries the given prompt: exact via the full-prompt
+/// hash when recorded, otherwise the legacy 200-character excerpt match.
+fn snapshot_prompt_matches(
+    snapshot: &RewindSnapshotInfo,
+    prompt: &str,
+    expected_hash: &str,
+) -> bool {
+    match &snapshot.prompt_hash {
+        Some(hash) => hash == expected_hash,
+        None => snapshot.prompt == prompt_excerpt(prompt),
+    }
+}
+
+/// Resolves the snapshot to restore for a conversation rewind.
+///
+/// Prefers the snapshot numbered `expected_index` (the transcript-ordinal
+/// mapping) when it also carries the selected prompt. When the ordinal
+/// alignment drifted (resumed threads restart ordinals while the snapshot
+/// chain continues, and rewind forks replay older messages without snapshots
+/// in the new chain), picks the newest snapshot carrying the selected
+/// prompt. Returns `None` when no snapshot matches the prompt.
+pub(crate) fn resolve_snapshot_for_message(
+    snapshots: &[RewindSnapshotInfo],
+    expected_index: u64,
+    prompt: &str,
+) -> Option<RewindSnapshotInfo> {
+    let expected_hash = prompt_hash_hex(prompt);
+    snapshots
+        .iter()
+        .find(|snapshot| {
+            snapshot.index == expected_index
+                && snapshot_prompt_matches(snapshot, prompt, &expected_hash)
+        })
+        .or_else(|| {
+            snapshots
+                .iter()
+                .filter(|snapshot| snapshot_prompt_matches(snapshot, prompt, &expected_hash))
+                .max_by_key(|snapshot| snapshot.index)
+        })
+        .cloned()
+}
+
+/// Resolves a snapshot across a whole workspace, used when a rewind fork's
+/// own chain has no match and the parent conversation's snapshots must be
+/// consulted. Snapshot indices are per-conversation, so a match is only
+/// returned when exactly one conversation carries the selected prompt;
+/// ambiguous matches decline to restore files rather than guessing.
+pub(crate) fn resolve_workspace_snapshot_for_message(
+    snapshots: &[RewindSnapshotInfo],
+    expected_index: u64,
+    prompt: &str,
+) -> Option<(String, u64)> {
+    let expected_hash = prompt_hash_hex(prompt);
+    let matching = snapshots
+        .iter()
+        .filter(|snapshot| snapshot_prompt_matches(snapshot, prompt, &expected_hash))
+        .collect::<Vec<_>>();
+    let threads = matching
+        .iter()
+        .map(|snapshot| snapshot.thread_id.as_str())
+        .collect::<BTreeSet<_>>();
+    if threads.len() != 1 {
+        return None;
+    }
+    let thread_id = threads.into_iter().next().expect("exactly one thread");
+    matching
+        .iter()
+        .filter(|snapshot| snapshot.thread_id == thread_id)
+        .find(|snapshot| snapshot.index == expected_index)
+        .or_else(|| {
+            matching
+                .iter()
+                .filter(|snapshot| snapshot.thread_id == thread_id)
+                .max_by_key(|snapshot| snapshot.index)
+        })
+        .map(|snapshot| (snapshot.thread_id.clone(), snapshot.index))
+}
