+fn first_snapshot_seeding_captures_changed_content() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"v1");
+    take(codex_home.path(), workspace.path(), "thread a");
+    fs::write(&file, b"v2").expect("modify");
+
+    // A fresh conversation seeds its fast path from thread A's snapshot but
+    // must still capture the changed content, not link the stale object.
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        OTHER_THREAD,
+        "thread b",
+        /*respect_gitignore*/ true,
+        DEFAULT_MAX_SNAPSHOTS,
+    )
+    .expect("snapshot b");
+
+    let chain_a = thread_root(codex_home.path(), workspace.path(), TEST_THREAD);
+    let chain_b = thread_root(codex_home.path(), workspace.path(), OTHER_THREAD);
+    let manifest_a = read_manifest(&chain_a.join("000001"))
+        .expect("read manifest")
+        .expect("manifest a");
+    let manifest_b = read_manifest(&chain_b.join("000001"))
+        .expect("read manifest")
+        .expect("manifest b");
+    assert_ne!(
+        manifest_a.files[0].object, manifest_b.files[0].object,
+        "changed content must not reuse the seeded object"
+    );
+    assert_eq!(
+        fs::read(chain_b.join("000001/files/notes.txt")).expect("read copy"),
+        b"v2"
+    );
+}
