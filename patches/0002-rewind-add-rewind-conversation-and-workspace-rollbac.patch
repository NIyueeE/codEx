+    /// Takes a `/rewind` file snapshot of the workspace before a user turn.
+    ///
+    /// The snapshot is taken synchronously so it always captures the state
+    /// before the turn's file writes begin. Failures never block submission,
+    /// but they are surfaced in the transcript so a silently broken rewind
+    /// chain cannot pass unnoticed.
+    pub(super) fn snapshot_workspace_before_turn(&mut self, text: &str) {
+        let Some(thread_id) = self.thread_id.as_ref().map(|id| id.to_string()) else {
+            tracing::warn!("failed to take rewind snapshot: no active thread");
+            return;
+        };
+        let codex_home = self.config.codex_home.clone();
+        let cwd = self.config.cwd.clone();
+        let respect_gitignore = self.config.rewind_respect_gitignore;
+        let max_snapshots = self.config.rewind_max_snapshots;
+        match crate::rewind::take_snapshot_with_skipped(
+            codex_home.as_path(),
+            cwd.as_path(),
+            &thread_id,
+            text,
+            respect_gitignore,
+            max_snapshots,
+        ) {
+            Ok((_snapshot, skipped)) => {
+                if !skipped.is_empty() {
+                    let shown = skipped
+                        .iter()
+                        .take(3)
+                        .map(|path| path.display().to_string())
+                        .collect::<Vec<_>>()
+                        .join(", ");
+                    let remaining = skipped.len().saturating_sub(3);
+                    let suffix = if remaining > 0 {
+                        format!(" (+{remaining} more)")
+                    } else {
+                        String::new()
+                    };
+                    self.add_to_history(history_cell::new_warning_event(format!(
+                        "Rewind snapshot skipped {} unreadable path(s): {shown}{suffix}. A later /rewind will leave them untouched.",
+                        skipped.len()
+                    )));
+                }
+            }
+            Err(err) => {
+                tracing::warn!(error = %err, "failed to take rewind snapshot");
+                self.add_to_history(history_cell::new_warning_event(format!(
+                    "Failed to take a rewind snapshot: {err}"
+                )));
+            }
+        }
+    }
 }
