+#[tokio::test]
+async fn rewind_files_and_conversation_forks_thread_before_selected_message() -> Result<()> {
+    // Build a rollout with three completed turns so the app server has real
+    // persisted turns to fork from.
+    let codex_home = tempfile::tempdir()?;
+    let workspace = tempfile::tempdir()?;
+    let filename_ts = "2025-01-05T12-00-00";
+    let meta_rfc3339 = "2025-01-05T12:00:00Z";
+    let thread_id = app_test_support::create_fake_rollout(
+        codex_home.path(),
+        filename_ts,
+        meta_rfc3339,
+        "first question",
+        /*model_provider*/ None,
+        /*git_info*/ None,
+    )
+    .map_err(|error| {
+        color_eyre::eyre::eyre!("failed to create fake rollout: {error}")
+    })?;
+    let rollout_path =
+        app_test_support::rollout_path(codex_home.path(), filename_ts, &thread_id);
+    let contents = std::fs::read_to_string(&rollout_path)?;
+    // Keep only the session_meta line; rebuild the conversation with explicit
+    // turn lifecycle events (task_started / item_completed / task_complete).
+    let session_meta_line = contents
+        .lines()
+        .next()
+        .expect("session meta line")
+        .to_string();
+    let mut lines = vec![session_meta_line];
+    let event_line = |payload: serde_json::Value| {
+        serde_json::json!({
+            "timestamp": meta_rfc3339,
+            "type": "event_msg",
+            "payload": payload,
+        })
+        .to_string()
+    };
+    for (turn_id, prompt) in [
+        ("turn-1", "first question"),
+        ("turn-2", "second question"),
+        ("turn-3", "third question"),
+    ] {
+        lines.push(event_line(serde_json::json!({
+            "type": "task_started",
+            "turn_id": turn_id,
+            "model_context_window": null,
+        })));
+        lines.push(event_line(serde_json::json!({
+            "type": "user_message",
+            "message": prompt,
+            "kind": "plain",
+        })));
+        lines.push(event_line(serde_json::json!({
+            "type": "agent_message",
+            "message": "ok",
+        })));
+        lines.push(event_line(serde_json::json!({
+            "type": "task_complete",
+            "turn_id": turn_id,
+            "last_agent_message": null,
+            "error": null,
+            "started_at": 10,
+            "completed_at": 20,
+            "duration_ms": 10_000,
+            "time_to_first_token_ms": null,
+        })));
+    }
+    std::fs::write(&rollout_path, lines.join("\n") + "\n")?;
+
+    let config = ConfigBuilder::default()
+        .codex_home(codex_home.path().to_path_buf())
+        .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+        .harness_overrides(ConfigOverrides {
+            cwd: Some(workspace.path().to_path_buf()),
+            ..Default::default()
+        })
+        .build()
+        .await?;
+    assert!(config.rewind_enabled);
+
+    let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    app.config = config.clone();
+    let mut app_server =
+        crate::start_embedded_app_server_for_picker(&config)
+            .await
+            .expect("embedded app server");
+    let resumed = app_server
+        .resume_thread(
+            config.clone(),
+            ThreadId::from_string(thread_id.as_str())?,
+            crate::app_server_session::ResumeModelSettings::RestoreFromThread,
+        )
+        .await
+        .expect("resume rollout thread");
+    let thread_id = resumed.session.thread_id;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.enqueue_primary_thread_session(resumed.session, resumed.turns)
+        .await
+        .expect("primary thread should be registered");
+    // History replay is delivered as app events; run them through the event
+    // loop so `transcript_cells` is populated like in a real session.
+    while let Ok(event) = app_event_rx.try_recv() {
+        app.handle_event(&mut tui, &mut app_server, event).await?;
+    }
+
+    // The `/rewind` message picker builds its selections from transcript cells.
+    let selections = app.rewind_message_selections();
+    assert_eq!(selections.len(), 3, "all turns should be rewindable");
+    let (nth, selection) = selections
+        .into_iter()
+        .next()
+        .expect("newest rewind selection");
+    assert_eq!(nth, 2);
+    assert_eq!(selection.prompt.text, "third question");
+
+    // Mirror the snapshots `/rewind` takes before each turn: one snapshot per
+    // submitted message, numbered from 1, capturing the workspace state.
+    let workspace_file = workspace.path().join("notes.txt");
+    std::fs::write(&workspace_file, "v1")?;
+    crate::rewind::take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "first question",
+        /*respect_gitignore*/ true,
+    )?;
+    std::fs::write(&workspace_file, "v2")?;
+    crate::rewind::take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "second question",
+        /*respect_gitignore*/ true,
+    )?;
+    std::fs::write(&workspace_file, "v3")?;
+    crate::rewind::take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "third question",
+        /*respect_gitignore*/ true,
+    )?;
+
+    // Exactly what the "Files and conversation" picker action sends.
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::ForkSessionForPromptEdit {
+            thread_id,
+            nth_user_message: nth,
+            prompt: selection.prompt.clone(),
+        },
+    )
+    .await?;
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::RewindRestoreFiles {
+            index: nth as u64,
+            prompt: selection.prompt.text.clone(),
+        },
+    )
+    .await?;
+    // The fork handler queues the forked thread's replay as app events; run
+    // them through the event loop like the real main loop would.
+    while let Ok(event) = app_event_rx.try_recv() {
+        app.handle_event(&mut tui, &mut app_server, event).await?;
+    }
+
+    let forked_thread_id = app
+        .chat_widget
+        .thread_id()
+        .expect("forked thread should be attached");
+    assert_ne!(forked_thread_id, thread_id);
+    let transcript = app
+        .transcript_cells
+        .iter()
+        .map(|cell| lines_to_single_string(&cell.display_lines(/*width*/ 120)))
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(
+        transcript.contains("first question"),
+        "forked thread should keep the first turn:\n{transcript}"
+    );
+    assert!(
+        transcript.contains("second question"),
+        "forked thread should keep the second turn:\n{transcript}"
+    );
+    assert!(
+        !transcript.contains("third question"),
+        "forked thread should drop the selected turn:\n{transcript}"
+    );
+    assert_eq!(
+        app.chat_widget.composer_text_with_pending(),
+        "third question",
+        "selected prompt should be restored to the composer"
+    );
+    assert_eq!(
+        std::fs::read_to_string(&workspace_file)?,
+        "v2",
+        "files should be restored to the snapshot taken before the selected turn"
+    );
+    app_server.shutdown().await?;
+    Ok(())
+}
