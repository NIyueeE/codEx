From 55f99bd31c168c2729ddc1ff56ae57680d7f1c21 Mon Sep 17 00:00:00 2001
From: codEx Fork Bot <codex-fork-bot@localhost>
Date: Tue, 11 Aug 2026 00:37:59 +0800
Subject: rewind: clear stale transcript when forking; fix snapshot index
 mapping

"Files and conversation" rewinds forked the thread correctly but left the
previous thread transcript cells in place, so the old conversation history
remained visible under the forked, truncated thread. Clear the transcript
and terminal scrollback before attaching the forked/resumed thread.

The message picker also mapped the 0-based transcript ordinal directly to
the snapshot index, but snapshots are numbered from 1, so files were
restored from one snapshot too early. Use nth + 1.
---
 codex-rs/tui/src/app/session_lifecycle.rs |   5 +
 codex-rs/tui/src/app/tests.rs             | 204 ++++++++++++++++++++++
 codex-rs/tui/src/rewind/actions.rs        |   5 +-
 3 files changed, 213 insertions(+), 1 deletion(-)

diff --git a/codex-rs/tui/src/app/session_lifecycle.rs b/codex-rs/tui/src/app/session_lifecycle.rs
index 51877ce..c998fe8 100644
--- a/codex-rs/tui/src/app/session_lifecycle.rs
+++ b/codex-rs/tui/src/app/session_lifecycle.rs
@@ -754,6 +754,11 @@ impl App {
             initial_user_message,
         );
         self.replace_chat_widget(ChatWidget::new_with_app_event(init));
+        // The previous thread's transcript cells and terminal scrollback must
+        // not leak into the attached thread: replay below appends new cells, so
+        // without this the old conversation stays visible after a fork, resume,
+        // or `/rewind` conversation rollback.
+        self.reset_for_thread_switch(tui)?;
         if started.blocks_direct_input {
             self.mark_primary_thread_parent_owned(started.session.thread_id);
         }
