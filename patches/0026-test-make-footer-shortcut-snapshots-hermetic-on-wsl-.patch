From f2c4d1c75dd63adfdcafc6e5ad192c3b0d4124a9 Mon Sep 17 00:00:00 2001
From: codEx Fork Bot <codex-fork-bot@localhost>
Date: Wed, 12 Aug 2026 23:35:32 +0800
Subject: test: make footer shortcut snapshots hermetic on wsl hosts

- The paste-image footer hint renders Ctrl+Alt+V under WSL and Ctrl+V
  elsewhere, so the shortcut-overlay snapshots failed on WSL hosts while
  passing on Linux CI. ChatComposer now carries a test-only WSL override
  and the overlay snapshot tests pin it to the non-WSL variant, matching
  the committed snapshots on any host.
---
 codex-rs/tui/src/bottom_pane/chat_composer.rs | 42 ++++++++++++++-----
 1 file changed, 32 insertions(+), 10 deletions(-)

diff --git a/codex-rs/tui/src/bottom_pane/chat_composer.rs b/codex-rs/tui/src/bottom_pane/chat_composer.rs
index 077ac97..7552510 100644
--- a/codex-rs/tui/src/bottom_pane/chat_composer.rs
+++ b/codex-rs/tui/src/bottom_pane/chat_composer.rs
@@ -492,6 +492,10 @@ pub(crate) struct ChatComposer {
     personality_command_enabled: bool,
     windows_degraded_sandbox_active: bool,
     side_conversation_active: bool,
+    /// Test-only override for the WSL footer hint so snapshot tests render
+    /// deterministically on any host (WSL, containers, CI).
+    #[cfg(test)]
+    test_is_wsl_override: Option<bool>,
     history_search: Option<HistorySearchSession>,
     submit_keys: Vec<KeyBinding>,
     queue_keys: Vec<KeyBinding>,
@@ -675,6 +679,8 @@ impl ChatComposer {
             personality_command_enabled: false,
             windows_degraded_sandbox_active: false,
             side_conversation_active: false,
+            #[cfg(test)]
+            test_is_wsl_override: None,
             history_search: None,
             submit_keys: vec![key_hint::plain(KeyCode::Enter)],
             queue_keys: vec![key_hint::plain(KeyCode::Tab)],
@@ -3719,16 +3725,7 @@ impl ChatComposer {
 
     fn footer_props(&self) -> FooterProps {
         let mode = self.footer_mode();
-        let is_wsl = {
-            #[cfg(target_os = "linux")]
-            {
-                mode == FooterMode::ShortcutOverlay && crate::clipboard_paste::is_probably_wsl()
-            }
-            #[cfg(not(target_os = "linux"))]
-            {
-                false
-            }
-        };
+        let is_wsl = self.footer_is_wsl(mode);
 
         FooterProps {
             mode,
@@ -3754,6 +3751,28 @@ impl ChatComposer {
         }
     }
 
+    fn footer_is_wsl(&self, mode: FooterMode) -> bool {
+        #[cfg(test)]
+        if let Some(override_value) = self.test_is_wsl_override {
+            return override_value;
+        }
+        #[cfg(target_os = "linux")]
+        {
+            mode == FooterMode::ShortcutOverlay && crate::clipboard_paste::is_probably_wsl()
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            false
+        }
+    }
+
+    /// Test-only override for the WSL footer hint so snapshot tests render
+    /// deterministically on any host (WSL, containers, CI).
+    #[cfg(test)]
+    pub(super) fn set_test_is_wsl_override(&mut self, value: Option<bool>) {
+        self.test_is_wsl_override = value;
+    }
+
     /// Resolve the effective footer mode via a small priority waterfall.
     ///
     /// The base mode is derived solely from whether the composer is empty:
@@ -4957,6 +4976,7 @@ mod tests {
             "footer_mode_configured_key_chords",
             /*enhanced_keys_supported*/ false,
             |composer| {
+                composer.set_test_is_wsl_override(/*is_wsl*/ Some(false));
                 composer.set_keymap_bindings(&keymap);
                 composer.footer.mode = FooterMode::ShortcutOverlay;
             },
@@ -5190,6 +5210,7 @@ mod tests {
             "footer_mode_shortcut_overlay",
             /*enhanced_keys_supported*/ true,
             |composer| {
+                composer.set_test_is_wsl_override(/*is_wsl*/ Some(false));
                 let _ = composer
                     .handle_key_event(KeyEvent::new(KeyCode::Char('?'), KeyModifiers::NONE));
             },
@@ -5199,6 +5220,7 @@ mod tests {
             "footer_mode_shortcut_overlay_queue_submissions",
             /*enhanced_keys_supported*/ true,
             |composer| {
+                composer.set_test_is_wsl_override(/*is_wsl*/ Some(false));
                 composer.set_queue_submissions(/*queue_submissions*/ true);
                 let _ = composer
                     .handle_key_event(KeyEvent::new(KeyCode::Char('?'), KeyModifiers::NONE));
