From 68eb5a11030cbfe7cabc490842d75707a4dfbeaa Mon Sep 17 00:00:00 2001
From: codEx Fork Bot <codex-fork-bot@localhost>
Date: Tue, 11 Aug 2026 01:20:45 +0800
Subject: branding: codEx name and version output

codex --version prints "codEx <version> (codEx fork)" while keeping plain
semver so fork release tags stay clean, and the sandboxed version-command
test accepts the capitalized fork name.
---
 codex-rs/cli/src/main.rs                   | 16 ++++++++++++++--
 codex-rs/cli/tests/sandbox_cloud_config.rs |  4 +++-
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/codex-rs/cli/src/main.rs b/codex-rs/cli/src/main.rs
index 597448e..a227eab 100644
--- a/codex-rs/cli/src/main.rs
+++ b/codex-rs/cli/src/main.rs
@@ -87,13 +87,14 @@ use codex_protocol::protocol::AskForApproval;
 use codex_protocol::user_input::UserInput;
 use codex_terminal_detection::TerminalName;
 
-/// Codex CLI
+/// codEx CLI
 ///
 /// If no subcommand is specified, options will be forwarded to the interactive CLI.
 #[derive(Debug, Parser)]
 #[clap(
     author,
-    version,
+    name = "codEx",
+    version = concat!(env!("CARGO_PKG_VERSION"), " (codEx fork)"),
     // If a sub‑command is given, ignore requirements of the default args.
     subcommand_negates_reqs = true,
     // The executable is sometimes invoked via a platform‑specific name like
@@ -3251,6 +3252,17 @@ mod tests {
         assert!(matches!(cli.subcommand, Some(Subcommand::Update)));
     }
 
+    #[test]
+    fn version_string_identifies_codex_fork() {
+        let command = MultitoolCli::command();
+        let version = command.get_version().expect("version");
+        assert_eq!(version, concat!(env!("CARGO_PKG_VERSION"), " (codEx fork)"));
+        assert!(
+            command.get_about().unwrap().to_string().contains("codEx"),
+            "about should mention codEx"
+        );
+    }
+
     #[test]
     fn archive_merges_scoped_tui_flags() {
         let (target, interactive, remote) = finalize_archive_from_args(
diff --git a/codex-rs/cli/tests/sandbox_cloud_config.rs b/codex-rs/cli/tests/sandbox_cloud_config.rs
index 81fbf07..f43276f 100644
--- a/codex-rs/cli/tests/sandbox_cloud_config.rs
+++ b/codex-rs/cli/tests/sandbox_cloud_config.rs
@@ -140,7 +140,9 @@ async fn sandbox_fetches_and_enforces_cloud_managed_permission_profile() -> Resu
     );
     if !nested_macos_sandbox_unavailable {
         assert!(
-            String::from_utf8(output.stdout)?.starts_with("codex"),
+            String::from_utf8(output.stdout)?
+                .to_lowercase()
+                .starts_with("codex"),
             "expected the sandboxed Codex version command to run",
         );
     }
