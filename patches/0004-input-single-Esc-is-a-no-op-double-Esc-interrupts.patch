+    /// Handles a single Esc press in the main UI (no modal, popup, overlay, or
+    /// vim/bash mode owns it).
+    ///
+    /// A single Esc is a no-op. While a reply is running, the first press arms
+    /// a short window and shows a footer hint; a second press within the window
+    /// stops the reply.
+    pub(crate) fn handle_main_esc_press(&mut self) {
+        if !self.is_cancellable_work_active() {
+            self.clear_esc_interrupt();
+            return;
+        }
+        if self.esc_interrupt_active() {
+            self.clear_esc_interrupt();
+            let submit_pending_steers = !self.input_queue.pending_steers.is_empty()
+                && self.bottom_pane.is_task_running()
+                && self.bottom_pane.no_modal_or_popup_active();
+            if submit_pending_steers {
+                self.input_queue.submit_pending_steers_after_interrupt = true;
+            }
+            if self.submit_op(AppCommand::interrupt()) {
+                self.pause_active_goal_for_interrupt();
+            } else if submit_pending_steers {
+                self.input_queue.submit_pending_steers_after_interrupt = false;
+            }
+            return;
+        }
+        self.arm_esc_interrupt();
+    }
+
+    /// True if a first Esc was pressed while a reply was running and the
+    /// second-press window has not expired.
+    pub(crate) fn esc_interrupt_active(&self) -> bool {
+        self.esc_interrupt_expires_at
+            .is_some_and(|expires_at| Instant::now() < expires_at)
+    }
+
+    /// Arm the double-Esc interrupt window and show the footer hint.
+    fn arm_esc_interrupt(&mut self) {
+        self.esc_interrupt_expires_at = Instant::now()
+            .checked_add(crate::bottom_pane::ESC_INTERRUPT_TIMEOUT)
+            .or_else(|| Some(Instant::now()));
+        self.bottom_pane.show_esc_interrupt_hint();
+    }
+
+    pub(super) fn clear_esc_interrupt(&mut self) {
+        if self.esc_interrupt_expires_at.is_some() {
+            self.esc_interrupt_expires_at = None;
+            self.bottom_pane.clear_esc_interrupt_hint();
+        }
+    }
