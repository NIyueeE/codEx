+    /// owns rendering. A redraw is scheduled after [`ESC_INTERRUPT_TIMEOUT`]
+    /// so the hint disappears even if the user stops typing.
+    pub(crate) fn show_esc_interrupt_hint(&mut self) {
+        self.composer.show_esc_interrupt_hint(self.has_input_focus);
+        let frame_requester = self.frame_requester.clone();
+        if let Ok(handle) = tokio::runtime::Handle::try_current() {
+            handle.spawn(async move {
+                tokio::time::sleep(ESC_INTERRUPT_TIMEOUT).await;
+                frame_requester.schedule_frame();
+            });
+        } else {
+            std::thread::spawn(move || {
+                std::thread::sleep(ESC_INTERRUPT_TIMEOUT);
+                frame_requester.schedule_frame();
+            });
+        }
+        self.request_redraw();
+    }
