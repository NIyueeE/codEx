-            &output.managed_codex_path,
-            output.managed_codex_version.as_deref(),
-        ),
-        AppServerRemoteControlStartOutput::Start(output) => (
-            &output.managed_codex_path,
-            output.managed_codex_version.as_deref(),
-        ),
-    }
