+use pretty_assertions::assert_eq;
+
+use super::version_from_release_url;
+
+#[test]
+fn version_from_release_url_reads_tag_and_download_urls() {
+    let cases = [
+        (
+            "https://github.com/NIyueeE/codEx/releases/tag/rust-v0.154.0",
+            Some("0.154.0"),
+        ),
+        ("/releases/tag/rust-v0.154.0", Some("0.154.0")),
+        (
+            "https://github.com/NIyueeE/codEx/releases/download/rust-v0.154.0/codex-x86_64-unknown-linux-musl.tar.gz",
+            Some("0.154.0"),
+        ),
+        (
+            "https://github.com/NIyueeE/codEx/releases/tag/v1.2.3",
+            Some("1.2.3"),
+        ),
+        ("https://github.com/NIyueeE/codEx/releases/latest", None),
+        ("https://github.com/NIyueeE/codEx", None),
+        ("", None),
+    ];
+    for (url, expected) in cases {
+        assert_eq!(
+            version_from_release_url(url).as_deref(),
+            expected,
+            "unexpected version for {url}"
+        );
+    }
+}
