+//! Identity of the codEx fork.
+//!
+//! The fork publishes its own release artifacts and update metadata from this
+//! GitHub repository. Update checks, `codex update`, and doctor diagnostics all
+//! resolve releases through this single constant so the fork points at itself
+//! instead of `openai/codex`.
+
+/// GitHub repository (`owner/name`) that publishes codEx fork releases.
+pub const FORK_REPO: &str = "NIyueeE/codEx";
+
+/// URL of the GitHub API "latest release" endpoint for the fork.
+///
+/// GitHub allows only 60 unauthenticated REST API requests per hour per source
+/// IP, which a shared address can exhaust without any local mistake, so
+/// [`latest_release_redirect_url`] is preferred and this endpoint is a fallback.
+pub fn latest_release_url() -> String {
+    format!("https://api.github.com/repos/{FORK_REPO}/releases/latest")
+}
+
+/// URL that redirects to the fork's newest release page.
+///
+/// `github.com` is not subject to the REST API request limit, and the redirect
+/// target names the newest tag, so callers resolve the latest version here
+/// first.
+pub fn latest_release_redirect_url() -> String {
+    format!("https://github.com/{FORK_REPO}/releases/latest")
+}
+
+/// Extracts a bare version from a `github.com` release URL.
+///
+/// Handles the page a `/releases/latest` redirect lands on
+/// (`https://github.com/o/r/releases/tag/rust-v0.154.0`) as well as release
+/// asset URLs (`https://github.com/o/r/releases/download/rust-v0.154.0/x.tar.gz`),
+/// which carry the tag in the same position. Returns `None` for any other URL,
+/// including `/releases/latest` itself when a response was not a redirect.
+pub fn version_from_release_url(url: &str) -> Option<String> {
+    let (_, rest) = url.split_once("/releases/")?;
+    let (kind, tail) = rest.split_once('/')?;
+    if kind != "tag" && kind != "download" {
+        return None;
+    }
+    strip_version_prefix(tail.split('/').next()?)
+}
+
+/// Strips the `rust-v`/`v` prefix from a release tag.
+///
+/// Returns `None` for an empty tag so callers can report a missing version
+/// instead of propagating an empty string.
+pub fn strip_version_prefix(tag: &str) -> Option<String> {
+    let version = tag
+        .strip_prefix("rust-v")
+        .or_else(|| tag.strip_prefix('v'))
+        .unwrap_or(tag);
+    (!version.is_empty()).then(|| version.to_string())
+}
