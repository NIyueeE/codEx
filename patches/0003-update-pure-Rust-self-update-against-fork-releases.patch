+/// Resolves the newest release version from the `github.com` release redirect.
+///
+/// Returns `None` when the response names no release tag, so the caller can
+/// fall back to the REST API.
+async fn fetch_latest_version_via_redirect(client_pool: &RouteAwareClientPool) -> Option<String> {
+    let response = client_pool
+        .request(Method::HEAD, latest_release_redirect_url())
+        .headers(default_headers())
+        .send()
+        .await
+        .ok()?;
+    response
+        .headers()
+        .get(LOCATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(version_from_release_url)
+        .or_else(|| version_from_release_url(response.url().as_str()))
+}
