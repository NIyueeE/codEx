+//! Pure-Rust self-update for standalone codEx fork installs.
+//!
+//! `codex update` downloads the `codex-<target>.tar.gz` archive for the
+//! current platform from the fork's latest GitHub release, verifies its
+//! sha256 against the published checksum asset, and atomically replaces the
+//! running binary and the bundled `bwrap` resource. The archive is built by
+//! the fork's release workflow with `codex` and `bwrap` at the archive root,
+//! so the new binary's embedded `CODEX_BWRAP_SHA256` matches the new bwrap.
+
+use std::path::Path;
+use std::time::Duration;
+
+use anyhow::Context;
+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_http_client::RouteAwareClientPool;
+use codex_install_context::InstallContext;
+use codex_install_context::InstallMethod;
+use codex_utils_cli::FORK_REPO;
+use codex_utils_cli::latest_release_url;
+use flate2::read::GzDecoder;
+use http::HeaderValue;
+use http::header::USER_AGENT;
+use sha2::Digest;
+use sha2::Sha256;
+use tar::Archive;
+
+/// Executable name inside the release archive.
+const CODEX_BINARY_NAME: &str = "codex";
+/// Windows executable name inside the release archive.
+#[cfg(target_os = "windows")]
+const CODEX_BINARY_NAME_WINDOWS: &str = "codex.exe";
+/// Directory beside the running binary that holds a pending update.
+const STAGING_DIR_NAME: &str = "codex-update-staging";
+/// Bundled helper directory inside a release archive and an install.
+#[cfg(target_os = "windows")]
+const RESOURCES_DIR_NAME: &str = "codex-resources";
+/// Bubblewrap binary name inside the release archive (Unix sandbox helper).
+const BWRAP_BINARY_NAME: &str = "bwrap";
+/// HTTP timeout for a single release asset download.
+const DOWNLOAD_TIMEOUT: Duration = Duration::from_secs(600);
+
+/// User-Agent sent with GitHub API/asset requests. GitHub's REST API rejects
+/// requests without a User-Agent header with HTTP 403.
+fn user_agent() -> HeaderValue {
+    HeaderValue::from_static(concat!(
+        "codex-cli/",
+        env!("CARGO_PKG_VERSION"),
+        " (codEx fork updater)"
+    ))
+}
+
+/// The platform triple codEx publishes binaries for this architecture.
+///
+/// The fork ships `x86_64-unknown-linux-musl` and `x86_64-pc-windows-msvc`.
+pub fn target_triple() -> Result<&'static str, String> {
+    match (std::env::consts::ARCH, std::env::consts::OS) {
+        ("x86_64", "linux") => Ok("x86_64-unknown-linux-musl"),
+        ("x86_64", "windows") => Ok("x86_64-pc-windows-msvc"),
+        (arch, os) => Err(format!(
+            "unsupported platform {arch}-{os}; codEx publishes Linux and Windows x86_64 binaries only"
+        )),
+    }
+}
+
+/// Name of the binary archive asset for `target`.
+pub fn archive_asset_name(target: &str) -> String {
+    format!("{CODEX_BINARY_NAME}-{target}.tar.gz")
+}
+
+/// Name of the sha256 checksum asset for `target`.
+pub fn checksum_asset_name(target: &str) -> String {
+    format!("{}.sha256", archive_asset_name(target))
+}
+
+/// Download URL for a release asset of the latest fork release.
+pub fn asset_download_url(asset_name: &str) -> String {
+    format!("https://github.com/{FORK_REPO}/releases/latest/download/{asset_name}")
+}
+
+/// Parses the published checksum asset (sha256sum format) for the archive.
+pub fn parse_checksum(checksum_contents: &str) -> Result<String, String> {
+    checksum_contents
+        .split_whitespace()
+        .next()
+        .filter(|token| token.len() == 64 && token.chars().all(|c| c.is_ascii_hexdigit()))
+        .map(str::to_owned)
+        .ok_or_else(|| "checksum asset does not contain a valid sha256 digest".to_string())
+}
+
+/// Performs the update: download, verify, extract, and replace.
+pub async fn run() -> anyhow::Result<()> {
+    let target = target_triple()
+        .map_err(anyhow::Error::msg)
+        .context("cannot update codEx")?;
+    let context = InstallContext::current();
+    let InstallMethod::Standalone {
+        release_dir,
+        resources_dir,
+        platform: _,
+    } = &context.method
+    else {
+        anyhow::bail!(
+            "codEx update only supports standalone installs. Please update manually from https://github.com/{FORK_REPO}/releases"
+        );
+    };
+
+    let latest_version = fetch_latest_version().await?;
+    println!(
+        "Found codEx {latest_version} (current: {})",
+        env!("CARGO_PKG_VERSION")
+    );
+
+    let archive_name = archive_asset_name(target);
+    let checksum_name = checksum_asset_name(target);
+    let archive_url = asset_download_url(&archive_name);
+    let checksum_url = asset_download_url(&checksum_name);
+
+    let client = RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy),
+        ClientRouteClass::Other,
+    );
+
+    println!("Downloading {archive_name}...");
+    let archive_bytes = download_bytes(&client, &archive_url).await?;
+    let checksum_bytes = download_bytes(&client, &checksum_url).await?;
+    let checksum_text =
+        String::from_utf8(checksum_bytes).context("checksum asset is not valid UTF-8")?;
+    let expected_checksum = parse_checksum(&checksum_text)
+        .map_err(anyhow::Error::msg)
+        .context("failed to parse checksum asset")?;
+    let actual_checksum = hex_sha256(&archive_bytes);
+    if actual_checksum != expected_checksum {
+        anyhow::bail!(
+            "checksum mismatch for {archive_name}: expected sha256:{expected_checksum}, got sha256:{actual_checksum}"
+        );
+    }
+    println!("sha256 verified ({expected_checksum})");
+
+    let current_exe = std::env::current_exe().context("failed to resolve current executable")?;
+
+    // The archive is extracted into a staging directory beside the running
+    // binary so both the Unix swap and the deferred Windows swap stay on one
+    // filesystem.
+    let staging_dir = staging_dir(&current_exe)?;
+    if staging_dir.exists() {
+        std::fs::remove_dir_all(&staging_dir)
+            .context("failed to clear a stale update staging directory")?;
+    }
+    std::fs::create_dir_all(&staging_dir)
+        .context("failed to create the update staging directory")?;
+
+    if let Err(err) = extract_archive(&archive_bytes, &staging_dir) {
+        let _ = std::fs::remove_dir_all(&staging_dir);
+        return Err(err).context("failed to extract release archive");
+    }
+
+    #[cfg(target_os = "windows")]
+    {
+        return stage_windows_update(&staging_dir).await;
+    }
+
+    #[cfg(not(target_os = "windows"))]
+    {
+        let new_codex = staging_dir.join(CODEX_BINARY_NAME);
+        let new_bwrap = staging_dir.join(BWRAP_BINARY_NAME);
+        if !new_codex.is_file() || !new_bwrap.is_file() {
+            anyhow::bail!("release archive is missing {CODEX_BINARY_NAME} or {BWRAP_BINARY_NAME}");
+        }
+        let Some(resources_dir) = resources_dir else {
+            anyhow::bail!(
+                "standalone install has no resources directory; cannot replace bundled bwrap. Please update manually from https://github.com/{FORK_REPO}/releases"
+            );
+        };
+
+        // Keep a copy of the current codex so a failed bwrap swap can roll codex
+        // back: the binary embeds the digest of the bundled bwrap, and a mismatched
+        // pair would break sandbox startup until the next update.
+        let codex_backup = staging_dir.join("codex.previous");
+        std::fs::copy(&current_exe, &codex_backup)
+            .context("failed to back up the current codex binary")?;
+
+        replace_binary(&new_codex, &current_exe)?;
+        if let Err(err) = replace_binary(&new_bwrap, &resources_dir.join(BWRAP_BINARY_NAME)) {
+            let _ = replace_binary(&codex_backup, &current_exe);
+            return Err(err);
+        }
+        let _ = std::fs::remove_dir_all(&staging_dir);
+        let _ = release_dir;
+        return Ok(());
+    }
+}
+
+/// Staging directory beside the running binary that holds the extracted
+/// release until it is swapped in.
+fn staging_dir(current_exe: &Path) -> anyhow::Result<std::path::PathBuf> {
+    let parent = current_exe
+        .parent()
+        .context("current executable has no parent directory")?;
+    Ok(parent.join(STAGING_DIR_NAME))
+}
+
+/// Windows cannot replace a running executable. The update is handed to a
+/// detached copy of the new binary, which waits for the current process to
+/// exit, swaps the install, and relaunches codEx.
+#[cfg(target_os = "windows")]
+async fn stage_windows_update(staging_dir: &Path) -> anyhow::Result<()> {
+    use std::os::windows::process::CommandExt;
+    use windows_sys::Win32::System::Threading::CREATE_NO_WINDOW;
+
+    let new_codex = staging_dir.join(CODEX_BINARY_NAME_WINDOWS);
+    if !new_codex.is_file() {
+        anyhow::bail!("release archive is missing {CODEX_BINARY_NAME_WINDOWS}");
+    }
+
+    let parent_pid = std::process::id();
+    let mut command = std::process::Command::new(&new_codex);
+    command
+        .arg("update")
+        .arg("--windows-apply-after-exit")
+        .arg(parent_pid.to_string())
+        .creation_flags(CREATE_NO_WINDOW)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null());
+    command
+        .spawn()
+        .with_context(|| format!("failed to start the staged updater {}", new_codex.display()))?;
+    println!("Update staged. codEx will close, finish updating, and restart.");
+    Ok(())
+}
+
+/// Waits for the codEx process that staged the update to exit, swaps the
+/// staged executable into the install directory, and relaunches codEx.
+///
+/// This runs from the staged binary, so it is only reachable through the
+/// hidden `codex update --windows-apply-after-exit <pid>` flag.
+#[cfg(target_os = "windows")]
+pub async fn run_windows_apply_after_exit(parent_pid: u32) -> anyhow::Result<()> {
+    use std::os::windows::process::CommandExt;
+    use windows_sys::Win32::Foundation::CloseHandle;
+    use windows_sys::Win32::System::Threading::CREATE_NO_WINDOW;
+    use windows_sys::Win32::System::Threading::INFINITE;
+    use windows_sys::Win32::System::Threading::OpenProcess;
+    use windows_sys::Win32::System::Threading::PROCESS_SYNCHRONIZE;
+    use windows_sys::Win32::System::Threading::WaitForSingleObject;
+
+    let current_exe =
+        std::env::current_exe().context("failed to resolve the staged updater path")?;
+    let staging_dir = staging_dir(&current_exe)?;
+    let target_dir = staging_dir
+        .parent()
+        .context("update staging directory has no parent")?
+        .to_path_buf();
+    let new_codex = staging_dir.join(CODEX_BINARY_NAME_WINDOWS);
+    if !new_codex.is_file() {
+        anyhow::bail!(
+            "staged update is missing {}; rerun `codex update`",
+            new_codex.display()
+        );
+    }
+
+    // Wait on the process handle rather than polling so a slow shutdown cannot
+    // race the swap; the handle closes on exit even when the process fails.
+    unsafe {
+        let handle = OpenProcess(PROCESS_SYNCHRONIZE, /*bInheritHandle*/ 0, parent_pid);
+        if !handle.is_null() {
+            WaitForSingleObject(handle, INFINITE);
+            let _ = CloseHandle(handle);
+        }
+    }
+
+    let target = target_dir.join(CODEX_BINARY_NAME_WINDOWS);
+    // Bundled helper binaries ship under `codex-resources/` in the archive and
+    // must live beside the install's resources directory, which the install
+    // context only reports when it already exists.
+    let staged_resources = staging_dir.join(RESOURCES_DIR_NAME);
+    if staged_resources.is_dir() {
+        let target_resources = target_dir.join(RESOURCES_DIR_NAME);
+        std::fs::create_dir_all(&target_resources)
+            .with_context(|| format!("failed to create {}", target_resources.display()))?;
+        for entry in std::fs::read_dir(&staged_resources)
+            .context("failed to list the staged resources directory")?
+        {
+            let entry = entry.context("failed to read a staged resource entry")?;
+            if entry.file_type().is_ok_and(|kind| kind.is_file()) {
+                replace_binary(&entry.path(), &target_resources.join(entry.file_name()))?;
+            }
+        }
+    }
+
+    // Swap the entrypoint last: a partially applied update then still runs the
+    // previous codEx, which can retry, instead of a new binary with stale
+    // helpers.
+    replace_binary(&new_codex, &target).context("failed to replace the installed codEx binary")?;
+    let _ = std::fs::remove_dir_all(&staging_dir);
+
+    std::process::Command::new(&target)
+        .creation_flags(CREATE_NO_WINDOW)
+        .spawn()
+        .with_context(|| format!("failed to relaunch {}", target.display()))?;
+    Ok(())
+}
+
+async fn fetch_latest_version() -> anyhow::Result<String> {
+    #[derive(serde::Deserialize)]
+    struct ReleaseInfo {
+        tag_name: String,
+    }
+
+    let client = RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy),
+        ClientRouteClass::Other,
+    );
+    let response = client
+        .get(latest_release_url())
+        .header(USER_AGENT, user_agent())
+        .timeout(Duration::from_secs(30))
+        .send()
+        .await
+        .context("failed to reach codEx release metadata")?;
+    let ReleaseInfo { tag_name } = response
+        .error_for_status()
+        .context("release metadata request failed")?
+        .json::<ReleaseInfo>()
+        .await
+        .context("failed to parse release metadata")?;
+    Ok(tag_name
+        .trim_start_matches("rust-v")
+        .trim_start_matches('v')
+        .to_string())
+}
+
+async fn download_bytes(client: &RouteAwareClientPool, url: &str) -> anyhow::Result<Vec<u8>> {
+    let response = client
+        .get(url)
+        .header(USER_AGENT, user_agent())
+        .timeout(DOWNLOAD_TIMEOUT)
+        .send()
+        .await
+        .with_context(|| format!("failed to download {url}"))?;
+    let bytes = response
+        .error_for_status()
+        .with_context(|| format!("download failed for {url}"))?
+        .bytes()
+        .await
+        .with_context(|| format!("failed to read body of {url}"))?;
+    Ok(bytes.to_vec())
+}
+
+fn hex_sha256(bytes: &[u8]) -> String {
+    let digest = Sha256::digest(bytes);
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut hex = String::with_capacity(64);
+    for byte in digest {
+        hex.push(HEX[(byte >> 4) as usize] as char);
+        hex.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    hex
+}
+
+fn extract_archive(archive_bytes: &[u8], dest_dir: &Path) -> anyhow::Result<()> {
+    let decoder = GzDecoder::new(archive_bytes);
+    let mut archive = Archive::new(decoder);
+    archive
+        .unpack(dest_dir)
+        .context("failed to unpack release archive")?;
+    Ok(())
+}
+
+/// Replaces `target` with `source`, preserving a `target.old` backup, and
+/// marks the result executable. The new file is fully staged (copy + chmod)
+/// before any rename, and a single atomic rename swaps it in, so the
+/// canonical path is never left missing. If the swap fails, the previous
+/// binary is restored from the backup.
+fn replace_binary(source: &Path, target: &Path) -> anyhow::Result<()> {
+    if let Some(parent) = target.parent() {
+        std::fs::create_dir_all(parent)
+            .with_context(|| format!("failed to create {}", parent.display()))?;
+    }
+    let backup = target.with_extension("old");
+    let staged = target.with_extension("new");
+    if target.exists() {
+        std::fs::copy(target, &backup)
+            .with_context(|| format!("failed to back up {}", target.display()))?;
+    }
+    std::fs::copy(source, &staged)
+        .with_context(|| format!("failed to stage {}", target.display()))?;
+    set_executable(&staged)?;
+    // POSIX rename - and MoveFileEx with MOVEFILE_REPLACE_EXISTING on Windows -
+    // atomically replaces the destination, so the canonical path always exists
+    // (old or new) at every instant.
+    if let Err(err) = replace_file(&staged, target) {
+        if backup.exists() {
+            let _ = replace_file(&backup, target);
+        }
+        return Err(err).with_context(|| format!("failed to replace {}", target.display()));
+    }
+    let _ = std::fs::remove_file(&backup);
+    Ok(())
+}
+
+/// Moves `source` onto `target`, replacing an existing target.
+///
+/// `std::fs::rename` refuses to overwrite on Windows, so the Windows path goes
+/// through `MoveFileEx` with `MOVEFILE_REPLACE_EXISTING`; Unix rename already
+/// replaces atomically.
+fn replace_file(source: &Path, target: &Path) -> std::io::Result<()> {
+    #[cfg(target_os = "windows")]
+    {
+        use std::os::windows::ffi::OsStrExt;
+        use windows_sys::Win32::Storage::FileSystem::MOVEFILE_REPLACE_EXISTING;
+        use windows_sys::Win32::Storage::FileSystem::MOVEFILE_WRITE_THROUGH;
+        use windows_sys::Win32::Storage::FileSystem::MoveFileExW;
+
+        let source: Vec<u16> = source.as_os_str().encode_wide().chain([0]).collect();
+        let target: Vec<u16> = target.as_os_str().encode_wide().chain([0]).collect();
+        let flags = MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH;
+        // SAFETY: both paths are NUL-terminated UTF-16 buffers that live for
+        // the duration of the call.
+        if unsafe { MoveFileExW(source.as_ptr(), target.as_ptr(), flags) } == 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        return Ok(());
+    }
+
+    #[cfg(not(target_os = "windows"))]
+    {
+        std::fs::rename(source, target)
+    }
+}
+
+fn set_executable(path: &Path) -> anyhow::Result<()> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mut permissions = std::fs::metadata(path)
+            .with_context(|| format!("failed to stat {}", path.display()))?
+            .permissions();
+        permissions.set_mode(0o755);
+        std::fs::set_permissions(path, permissions)
+            .with_context(|| format!("failed to chmod {}", path.display()))?;
+    }
+    let _ = path;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn target_triple_maps_supported_arches() {
+        // The mapping is static per build target; assert the current host is
+        // handled and that the naming scheme matches the release assets.
+        let expected = if cfg!(target_os = "windows") {
+            "x86_64-pc-windows-msvc"
+        } else {
+            "x86_64-unknown-linux-musl"
+        };
+        let triple = target_triple().expect("host should be supported");
+        if cfg!(target_arch = "x86_64") {
+            assert_eq!(triple, expected);
+        }
+        assert_eq!(archive_asset_name(triple), format!("codex-{triple}.tar.gz"));
+    }
+
+    #[test]
+    fn staging_directory_sits_beside_the_running_binary() {
+        let temp = tempfile::tempdir().expect("temp dir");
+        let exe = temp.path().join("codex");
+        assert_eq!(
+            staging_dir(&exe).expect("staging dir"),
+            temp.path().join(STAGING_DIR_NAME)
+        );
+    }
+
+    #[test]
+    fn asset_names_and_urls_point_at_fork_releases() {
+        assert_eq!(
+            checksum_asset_name("x86_64-unknown-linux-musl"),
+            "codex-x86_64-unknown-linux-musl.tar.gz.sha256"
+        );
+        assert_eq!(
+            asset_download_url("codex-x86_64-unknown-linux-musl.tar.gz"),
+            "https://github.com/NIyueeE/codEx/releases/latest/download/codex-x86_64-unknown-linux-musl.tar.gz"
+        );
+    }
+
+    #[test]
+    fn parses_sha256sum_style_checksum() {
+        let digest = "ab".repeat(32);
+        assert_eq!(
+            parse_checksum(&format!("{digest}  codex-x86_64-unknown-linux-musl.tar.gz")),
+            Ok(digest)
+        );
+        assert!(parse_checksum("not-a-checksum").is_err());
+        assert!(parse_checksum("").is_err());
+    }
+
+    #[test]
+    fn hex_sha256_matches_known_digest() {
+        assert_eq!(
+            hex_sha256(b"hello"),
+            "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
+        );
+    }
+
+    #[test]
+    fn replaces_binary_atomically_with_backup() {
+        let temp = tempfile::tempdir().expect("temp dir");
+        let source = temp.path().join("new-codex");
+        let target = temp.path().join("codex");
+        std::fs::write(&source, b"new bytes").expect("write source");
+        std::fs::write(&target, b"old bytes").expect("write target");
+
+        replace_binary(&source, &target).expect("replace should succeed");
+        assert_eq!(std::fs::read(&target).expect("read target"), b"new bytes");
+    }
+
+    #[test]
+    fn extracts_gzip_tar_archive() {
+        let temp = tempfile::tempdir().expect("temp dir");
+        let source_dir = temp.path().join("src");
+        std::fs::create_dir_all(&source_dir).expect("create src");
+        std::fs::write(source_dir.join("codex"), b"codex").expect("write codex");
+        std::fs::write(source_dir.join("bwrap"), b"bwrap").expect("write bwrap");
+
+        let encoder = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+        let mut tar_builder = tar::Builder::new(encoder);
+        tar_builder
+            .append_dir_all(".", &source_dir)
+            .expect("append dir");
+        let compressed = tar_builder
+            .into_inner()
+            .expect("finish tar")
+            .finish()
+            .expect("finish gzip");
+
+        let dest = temp.path().join("dest");
+        extract_archive(&compressed, &dest).expect("extract");
+        assert!(dest.join("codex").is_file());
+        assert!(dest.join("bwrap").is_file());
+    }
+}
