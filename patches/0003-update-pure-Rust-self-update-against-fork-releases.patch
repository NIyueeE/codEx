diff --git a/codex-rs/cli/src/release_metadata.rs b/codex-rs/cli/src/release_metadata.rs
new file mode 100644
index 0000000..af3ee05
--- /dev/null
+++ b/codex-rs/cli/src/release_metadata.rs
@@ -0,0 +1,124 @@
+//! Resolution of the codEx fork's newest published release version.
+//!
+//! `codex update` and `codex doctor` both need to know which tag the fork
+//! published last. The GitHub REST API answers that question, but it allows
+//! only 60 unauthenticated requests per hour per source IP, so a shared or
+//! NATed address can exhaust the quota without any local mistake -- which then
+//! blocks updates with a bare `403 rate limit exceeded`.
+//!
+//! `https://github.com/<repo>/releases/latest` redirects to the same tag
+//! outside the REST API limit, so that redirect is tried first and the API is
+//! kept only as a fallback (authenticated with `GITHUB_TOKEN`/`GH_TOKEN` when
+//! either is set).
+
+use std::time::Duration;
+
+use anyhow::Context;
+use codex_http_client::RouteAwareClientPool;
+use codex_utils_cli::latest_release_redirect_url;
+use codex_utils_cli::latest_release_url;
+use codex_utils_cli::strip_version_prefix;
+use codex_utils_cli::version_from_release_url;
+use http::Method;
+use http::StatusCode;
+use http::header::AUTHORIZATION;
+use http::header::LOCATION;
+use http::header::USER_AGENT;
+
+/// `User-Agent` sent with release-metadata requests. GitHub rejects REST API
+/// requests without one.
+const USER_AGENT_VALUE: &str = concat!(
+    "codex-cli/",
+    env!("CARGO_PKG_VERSION"),
+    " (codEx fork updater)"
+);
+/// Environment variables holding a token that raises the REST API rate limit.
+const TOKEN_ENV_VARS: [&str; 2] = ["GITHUB_TOKEN", "GH_TOKEN"];
+/// Timeout for a single metadata lookup.
+const METADATA_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// Resolves the version of the fork's newest published release.
+pub(crate) async fn fetch_latest_version(client: &RouteAwareClientPool) -> anyhow::Result<String> {
+    if let Some(version) = fetch_latest_version_via_redirect(client).await {
+        return Ok(version);
+    }
+    fetch_latest_version_via_api(client).await
+}
+
+/// Resolves the newest version from the `github.com` release redirect.
+///
+/// Costs no REST API quota. Returns `None` when the response neither carries a
+/// `Location` header nor redirects to a release tag, so callers can fall back
+/// to the API.
+pub(crate) async fn fetch_latest_version_via_redirect(
+    client: &RouteAwareClientPool,
+) -> Option<String> {
+    let response = client
+        .request(Method::HEAD, latest_release_redirect_url())
+        .header(USER_AGENT, USER_AGENT_VALUE)
+        .timeout(METADATA_TIMEOUT)
+        .send()
+        .await
+        .ok()?;
+    response
+        .headers()
+        .get(LOCATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(version_from_release_url)
+        .or_else(|| version_from_release_url(response.url().as_str()))
+}
+
+/// Resolves the newest version from the GitHub REST API.
+async fn fetch_latest_version_via_api(client: &RouteAwareClientPool) -> anyhow::Result<String> {
+    #[derive(serde::Deserialize)]
+    struct ReleaseInfo {
+        tag_name: String,
+    }
+
+    let request = client
+        .get(latest_release_url())
+        .header(USER_AGENT, USER_AGENT_VALUE)
+        .timeout(METADATA_TIMEOUT);
+    let request = match github_token() {
+        Some(token) => request.header(AUTHORIZATION, format!("Bearer {token}")),
+        None => request,
+    };
+    let response = request
+        .send()
+        .await
+        .context("failed to reach codEx release metadata")?;
+    let status = response.status();
+    let ReleaseInfo { tag_name } = response
+        .error_for_status()
+        .map_err(|err| with_quota_hint(status, anyhow::Error::new(err)))
+        .context("release metadata request failed")?
+        .json::<ReleaseInfo>()
+        .await
+        .context("failed to parse release metadata")?;
+    strip_version_prefix(&tag_name)
+        .ok_or_else(|| anyhow::anyhow!("latest release tag `{tag_name}` does not name a version"))
+}
+
+/// Explains how to recover from an exhausted unauthenticated API quota.
+fn with_quota_hint(status: StatusCode, err: anyhow::Error) -> anyhow::Error {
+    if !matches!(
+        status,
+        StatusCode::FORBIDDEN | StatusCode::TOO_MANY_REQUESTS
+    ) {
+        return err;
+    }
+    err.context(
+        "GitHub allows 60 unauthenticated API requests per hour per IP address; \
+         set GITHUB_TOKEN or GH_TOKEN to raise the limit, or retry after the quota resets",
+    )
+}
+
+/// Token from the environment that raises the GitHub REST API rate limit.
+fn github_token() -> Option<String> {
+    TOKEN_ENV_VARS.into_iter().find_map(|name| {
+        std::env::var(name)
+            .ok()
+            .map(|token| token.trim().to_string())
+            .filter(|token| !token.is_empty())
+    })
+}
