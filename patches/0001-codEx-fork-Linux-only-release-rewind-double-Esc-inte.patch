+#[test]
+fn take_snapshot_skips_gitignored_files_when_enabled() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "src/main.rs", b"fn main() {}");
+    write_file(workspace.path(), "target/debug/out", b"binary");
+    write_file(workspace.path(), ".gitignore", b"target/\n");
+
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "build",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot");
+    let snapshots = list_snapshots(codex_home.path(), workspace.path());
+    assert_eq!(snapshots.len(), 1);
+    let manifest = read_manifest(
+        &snapshots_root(codex_home.path(), workspace.path())
+            .join(format!("{:06}", snapshots[0].index)),
+    )
+    .expect("read manifest")
+    .expect("manifest exists");
+    assert_eq!(manifest.files.len(), 2); // src/main.rs + .gitignore
+}
+
+#[test]
+fn take_snapshot_includes_gitignored_files_when_disabled() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "target/debug/out", b"binary");
