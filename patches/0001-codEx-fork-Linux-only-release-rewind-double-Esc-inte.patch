diff --git a/codex-rs/cli/src/self_update.rs b/codex-rs/cli/src/self_update.rs
new file mode 100644
index 0000000000..5d59836afd
--- /dev/null
+++ b/codex-rs/cli/src/self_update.rs
@@ -0,0 +1,331 @@
+//! Pure-Rust self-update for standalone codEx fork installs.
+//!
+//! `codex update` downloads the `codex-<target>.tar.gz` archive for the
+//! current platform from the fork's latest GitHub release, verifies its
+//! sha256 against the published checksum asset, and atomically replaces the
+//! running binary and the bundled `bwrap` resource. The archive is built by
+//! the fork's release workflow with `codex` and `bwrap` at the archive root,
+//! so the new binary's embedded `CODEX_BWRAP_SHA256` matches the new bwrap.
+
+use std::path::Path;
+use std::time::Duration;
+
+use anyhow::Context;
+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_http_client::RouteAwareClientPool;
+use codex_install_context::InstallContext;
+use codex_install_context::InstallMethod;
+use codex_install_context::StandalonePlatform;
+use codex_utils_cli::FORK_REPO;
+use codex_utils_cli::latest_release_url;
+use flate2::read::GzDecoder;
+use sha2::Digest;
+use sha2::Sha256;
+use tar::Archive;
+
+/// Executable name inside the release archive.
+const CODEX_BINARY_NAME: &str = "codex";
+/// Bubblewrap binary name inside the release archive.
+const BWRAP_BINARY_NAME: &str = "bwrap";
+/// HTTP timeout for a single release asset download.
+const DOWNLOAD_TIMEOUT: Duration = Duration::from_secs(600);
+
+/// The platform triple codEx publishes binaries for this architecture.
+///
+/// The fork only ships `x86_64`/`aarch64` `unknown-linux-musl` builds.
+pub fn target_triple() -> Result<&'static str, String> {
+    match (std::env::consts::ARCH, std::env::consts::OS) {
+        ("x86_64", "linux") => Ok("x86_64-unknown-linux-musl"),
+        ("aarch64", "linux") => Ok("aarch64-unknown-linux-musl"),
+        (arch, os) => Err(format!(
+            "unsupported platform {arch}-{os}; codEx publishes Linux x86_64 and aarch64 binaries"
+        )),
+    }
+}
+
+/// Name of the binary archive asset for `target`.
+pub fn archive_asset_name(target: &str) -> String {
+    format!("{CODEX_BINARY_NAME}-{target}.tar.gz")
+}
+
+/// Name of the sha256 checksum asset for `target`.
+pub fn checksum_asset_name(target: &str) -> String {
+    format!("{}.sha256", archive_asset_name(target))
+}
+
+/// Download URL for a release asset of the latest fork release.
+pub fn asset_download_url(asset_name: &str) -> String {
+    format!("https://github.com/{FORK_REPO}/releases/latest/download/{asset_name}")
+}
+
+/// Parses the published checksum asset (sha256sum format) for the archive.
+pub fn parse_checksum(checksum_contents: &str) -> Result<String, String> {
+    checksum_contents
+        .split_whitespace()
+        .next()
+        .filter(|token| token.len() == 64 && token.chars().all(|c| c.is_ascii_hexdigit()))
+        .map(str::to_owned)
+        .ok_or_else(|| "checksum asset does not contain a valid sha256 digest".to_string())
+}
+
+/// Performs the update: download, verify, extract, and replace.
+pub async fn run() -> anyhow::Result<()> {
+    let target = target_triple()
+        .map_err(anyhow::Error::msg)
+        .context("cannot update codEx")?;
+    let context = InstallContext::current();
+    let resources_dir = match &context.method {
+        InstallMethod::Standalone {
+            resources_dir,
+            platform: StandalonePlatform::Unix,
+            ..
+        } => resources_dir.clone(),
+        InstallMethod::Standalone { .. } => {
+            anyhow::bail!(
+                "Windows standalone installs are not supported by the codEx fork; please update manually from https://github.com/{FORK_REPO}/releases"
+            );
+        }
+        _ => anyhow::bail!(
+            "codEx update only supports standalone installs. Please update manually from https://github.com/{FORK_REPO}/releases"
+        ),
+    };
+    let Some(resources_dir) = resources_dir else {
+        anyhow::bail!(
+            "standalone install has no resources directory; cannot replace bundled bwrap. Please update manually from https://github.com/{FORK_REPO}/releases"
+        );
+    };
+
+    let latest_version = fetch_latest_version().await?;
+    println!(
+        "Found codEx {latest_version} (current: {})",
+        env!("CARGO_PKG_VERSION")
+    );
+
+    let archive_name = archive_asset_name(target);
+    let checksum_name = checksum_asset_name(target);
+    let archive_url = asset_download_url(&archive_name);
+    let checksum_url = asset_download_url(&checksum_name);
+
+    let client = RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy),
+        ClientRouteClass::Other,
+    );
+
+    println!("Downloading {archive_name}...");
+    let archive_bytes = download_bytes(&client, &archive_url).await?;
+    let checksum_bytes = download_bytes(&client, &checksum_url).await?;
+    let checksum_text =
+        String::from_utf8(checksum_bytes).context("checksum asset is not valid UTF-8")?;
+    let expected_checksum = parse_checksum(&checksum_text)
+        .map_err(anyhow::Error::msg)
+        .context("failed to parse checksum asset")?;
+    let actual_checksum = hex_sha256(&archive_bytes);
+    if actual_checksum != expected_checksum {
+        anyhow::bail!(
+            "checksum mismatch for {archive_name}: expected sha256:{expected_checksum}, got sha256:{actual_checksum}"
+        );
+    }
+    println!("sha256 verified ({expected_checksum})");
+
+    let temp_dir = tempfile::tempdir().context("failed to create temporary directory")?;
+    extract_archive(&archive_bytes, temp_dir.path())
+        .context("failed to extract release archive")?;
+    let new_codex = temp_dir.path().join(CODEX_BINARY_NAME);
+    let new_bwrap = temp_dir.path().join(BWRAP_BINARY_NAME);
+    if !new_codex.is_file() || !new_bwrap.is_file() {
+        anyhow::bail!("release archive is missing {CODEX_BINARY_NAME} or {BWRAP_BINARY_NAME}");
+    }
+
+    let current_exe = std::env::current_exe().context("failed to resolve current executable")?;
+    replace_binary(&new_bwrap, &resources_dir.join(BWRAP_BINARY_NAME))?;
+    replace_binary(&new_codex, &current_exe)?;
+    Ok(())
+}
+
+async fn fetch_latest_version() -> anyhow::Result<String> {
+    #[derive(serde::Deserialize)]
+    struct ReleaseInfo {
+        tag_name: String,
+    }
+
+    let client = RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy),
+        ClientRouteClass::Other,
+    );
+    let response = client
+        .get(latest_release_url())
+        .timeout(Duration::from_secs(30))
+        .send()
+        .await
+        .context("failed to reach codEx release metadata")?;
+    let ReleaseInfo { tag_name } = response
+        .error_for_status()
+        .context("release metadata request failed")?
+        .json::<ReleaseInfo>()
+        .await
+        .context("failed to parse release metadata")?;
+    Ok(tag_name
+        .trim_start_matches("rust-v")
+        .trim_start_matches('v')
+        .to_string())
+}
+
+async fn download_bytes(client: &RouteAwareClientPool, url: &str) -> anyhow::Result<Vec<u8>> {
+    let response = client
+        .get(url)
+        .timeout(DOWNLOAD_TIMEOUT)
+        .send()
+        .await
+        .with_context(|| format!("failed to download {url}"))?;
+    let bytes = response
+        .error_for_status()
+        .with_context(|| format!("download failed for {url}"))?
+        .bytes()
+        .await
+        .with_context(|| format!("failed to read body of {url}"))?;
+    Ok(bytes.to_vec())
+}
+
+fn hex_sha256(bytes: &[u8]) -> String {
+    let digest = Sha256::digest(bytes);
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut hex = String::with_capacity(64);
+    for byte in digest {
+        hex.push(HEX[(byte >> 4) as usize] as char);
+        hex.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    hex
+}
+
+fn extract_archive(archive_bytes: &[u8], dest_dir: &Path) -> anyhow::Result<()> {
+    let decoder = GzDecoder::new(archive_bytes);
+    let mut archive = Archive::new(decoder);
+    archive
+        .unpack(dest_dir)
+        .context("failed to unpack release archive")?;
+    Ok(())
+}
+
+/// Replaces `target` with `source`, preserving a `target.old` backup, and
+/// marks the result executable.
+fn replace_binary(source: &Path, target: &Path) -> anyhow::Result<()> {
+    if let Some(parent) = target.parent() {
+        std::fs::create_dir_all(parent)
+            .with_context(|| format!("failed to create {}", parent.display()))?;
+    }
+    let backup = target.with_extension("old");
+    if target.exists() {
+        std::fs::rename(target, &backup)
+            .with_context(|| format!("failed to back up {}", target.display()))?;
+    }
+    let staged = target.with_extension("new");
+    std::fs::copy(source, &staged)
+        .with_context(|| format!("failed to stage {}", target.display()))?;
+    set_executable(&staged)?;
+    std::fs::rename(&staged, target)
+        .with_context(|| format!("failed to replace {}", target.display()))?;
+    if backup.exists() {
+        let _ = std::fs::remove_file(&backup);
+    }
+    Ok(())
+}
+
+fn set_executable(path: &Path) -> anyhow::Result<()> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mut permissions = std::fs::metadata(path)
+            .with_context(|| format!("failed to stat {}", path.display()))?
+            .permissions();
+        permissions.set_mode(0o755);
+        std::fs::set_permissions(path, permissions)
+            .with_context(|| format!("failed to chmod {}", path.display()))?;
+    }
+    let _ = path;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn target_triple_maps_supported_arches() {
+        // The mapping is static per build target; assert the current host is
+        // handled and that the naming scheme matches the release assets.
+        let triple = target_triple().expect("host should be supported");
+        assert!(triple.ends_with("-unknown-linux-musl"));
+        assert_eq!(archive_asset_name(triple), format!("codex-{triple}.tar.gz"));
+    }
+
+    #[test]
+    fn asset_names_and_urls_point_at_fork_releases() {
+        assert_eq!(
+            checksum_asset_name("x86_64-unknown-linux-musl"),
+            "codex-x86_64-unknown-linux-musl.tar.gz.sha256"
+        );
+        assert_eq!(
+            asset_download_url("codex-x86_64-unknown-linux-musl.tar.gz"),
+            "https://github.com/NIyueeE/codEx/releases/latest/download/codex-x86_64-unknown-linux-musl.tar.gz"
+        );
+    }
+
+    #[test]
+    fn parses_sha256sum_style_checksum() {
+        let digest = "ab".repeat(32);
+        assert_eq!(
+            parse_checksum(&format!("{digest}  codex-x86_64-unknown-linux-musl.tar.gz")),
+            Ok(digest)
+        );
+        assert!(parse_checksum("not-a-checksum").is_err());
+        assert!(parse_checksum("").is_err());
+    }
+
+    #[test]
+    fn hex_sha256_matches_known_digest() {
+        assert_eq!(
+            hex_sha256(b"hello"),
+            "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
+        );
+    }
+
+    #[test]
+    fn replaces_binary_atomically_with_backup() {
+        let temp = tempfile::tempdir().expect("temp dir");
+        let source = temp.path().join("new-codex");
+        let target = temp.path().join("codex");
+        std::fs::write(&source, b"new bytes").expect("write source");
+        std::fs::write(&target, b"old bytes").expect("write target");
+
+        replace_binary(&source, &target).expect("replace should succeed");
+        assert_eq!(std::fs::read(&target).expect("read target"), b"new bytes");
+    }
+
+    #[test]
+    fn extracts_gzip_tar_archive() {
+        let temp = tempfile::tempdir().expect("temp dir");
+        let source_dir = temp.path().join("src");
+        std::fs::create_dir_all(&source_dir).expect("create src");
+        std::fs::write(source_dir.join("codex"), b"codex").expect("write codex");
+        std::fs::write(source_dir.join("bwrap"), b"bwrap").expect("write bwrap");
+
+        let encoder = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+        let mut tar_builder = tar::Builder::new(encoder);
+        tar_builder
+            .append_dir_all(".", &source_dir)
+            .expect("append dir");
+        let compressed = tar_builder
+            .into_inner()
+            .expect("finish tar")
+            .finish()
+            .expect("finish gzip");
+
+        let dest = temp.path().join("dest");
+        extract_archive(&compressed, &dest).expect("extract");
+        assert!(dest.join("codex").is_file());
+        assert!(dest.join("bwrap").is_file());
+    }
+}
