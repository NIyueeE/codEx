index 0000000000..6b69db1d33
--- /dev/null
+++ b/codex-rs/utils/cli/src/fork.rs
@@ -0,0 +1,14 @@
+//! Identity of the codEx fork.
+//!
+//! The fork publishes its own release artifacts and update metadata from this
+//! GitHub repository. Update checks, `codex update`, and doctor diagnostics all
+//! resolve releases through this single constant so the fork points at itself
+//! instead of `openai/codex`.
+
+/// GitHub repository (`owner/name`) that publishes codEx fork releases.
+pub const FORK_REPO: &str = "NIyueeE/codEx";
+
+/// URL of the GitHub API "latest release" endpoint for the fork.
+pub fn latest_release_url() -> String {
+    format!("https://api.github.com/repos/{FORK_REPO}/releases/latest")
+}
