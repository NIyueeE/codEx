+use super::*;
+use pretty_assertions::assert_eq;
+
+fn write_file(root: &Path, relative: &str, contents: &[u8]) -> PathBuf {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().expect("parent")).expect("create parent");
+    fs::write(&path, contents).expect("write file");
+    path
+}
+
+#[test]
+fn take_snapshot_captures_files_and_manifest() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "src/main.rs", b"fn main() {}");
+    write_file(workspace.path(), ".git/HEAD", b"ref");
+    write_file(workspace.path(), ".gitignore", b"target/\n");
+
+    let snapshot = take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "first message",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot");
+
+    assert!(snapshot.join(MANIFEST_FILE_NAME).is_file());
+    assert!(snapshot.join("files/src/main.rs").is_file());
+    // .git and .gitignore itself are never captured.
+    assert!(!snapshot.join("files/.git/HEAD").exists());
+    let manifest = read_manifest(&snapshot)
+        .expect("read manifest")
+        .expect("manifest exists");
+    assert_eq!(manifest.version, MANIFEST_VERSION);
+    assert_eq!(manifest.prompt, "first message");
+    assert_eq!(
+        manifest
+            .files
+            .iter()
+            .map(|entry| entry.path.as_str())
+            .collect::<Vec<_>>(),
+        vec![".gitignore", "src/main.rs"]
+    );
+}
