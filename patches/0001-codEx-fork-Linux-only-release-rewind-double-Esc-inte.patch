+
+#[test]
+fn snapshots_are_incremental_and_renumbered() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let main_rs = write_file(workspace.path(), "src/main.rs", b"v1");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "one",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot one");
+    fs::write(&main_rs, b"v2").expect("modify");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "two",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot two");
+
+    let snapshots = list_snapshots(codex_home.path(), workspace.path());
+    assert_eq!(
+        snapshots.iter().map(|info| info.index).collect::<Vec<_>>(),
+        vec![1, 2]
+    );
+    let root = snapshots_root(codex_home.path(), workspace.path());
+    assert_eq!(
+        fs::read(root.join("000002/files/src/main.rs")).expect("read copy"),
+        b"v2"
+    );
+    assert_eq!(
+        fs::read(root.join("000001/files/src/main.rs")).expect("read copy"),
+        b"v1"
+    );
+}
+
+#[test]
+fn restore_rolls_back_changes_and_deletes_new_files() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "src/main.rs", b"v1");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "before",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot");
+
+    write_file(workspace.path(), "src/main.rs", b"v2");
+    write_file(workspace.path(), "new-file.txt", b"extra");
+    write_file(workspace.path(), "new-dir/nested.txt", b"nested");
+
+    let restored = restore_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        /*index*/ 1,
+        /*respect_gitignore*/ true,
+    )
+    .expect("restore");
+    assert_eq!(restored, 1);
+    assert_eq!(
+        fs::read(workspace.path().join("src/main.rs")).expect("read"),
+        b"v1"
+    );
+    assert!(!workspace.path().join("new-file.txt").exists());
+    assert!(!workspace.path().join("new-dir/nested.txt").exists());
+}
+
+#[test]
+fn snapshot_count_is_pruned_to_max() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "file.txt", b"data");
+    for index in 1..=MAX_SNAPSHOTS + 3 {
+        take_snapshot(
+            codex_home.path(),
+            workspace.path(),
+            &format!("message {index}"),
+            /*respect_gitignore*/ true,
+        )
+        .expect("snapshot");
+    }
+    let snapshots = list_snapshots(codex_home.path(), workspace.path());
+    assert_eq!(snapshots.len(), MAX_SNAPSHOTS);
+    assert_eq!(snapshots[0].index, 4);
+}
+
+#[test]
+fn prompt_excerpt_truncates_long_messages() {
+    let long = "x".repeat(500);
+    let excerpt = prompt_excerpt(&long);
+    assert!(excerpt.len() < 250);
+    assert!(excerpt.ends_with('…'));
+    assert_eq!(prompt_excerpt("   "), "(attachment)");
+    assert_eq!(prompt_excerpt("hello"), "hello");
+}
+
+#[test]
+fn workspace_hash_is_stable() {
+    let dir = tempfile::tempdir().expect("temp dir");
+    let root = snapshots_root(Path::new("/tmp/codex-home"), dir.path());
+    let root_again = snapshots_root(Path::new("/tmp/codex-home"), dir.path());
+    assert_eq!(root, root_again);
+    assert!(root.starts_with("/tmp/codex-home/snapshots"));
+}
