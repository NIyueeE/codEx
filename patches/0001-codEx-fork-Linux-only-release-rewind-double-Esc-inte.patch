+#[tokio::test]
+async fn double_esc_interrupts_running_reply_and_single_esc_is_noop() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let _esc = KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE);
+
+    // Idle: single Esc is a no-op.
+    chat.handle_main_esc_press();
+    assert!(!chat.esc_interrupt_active());
+    assert!(!chat.bottom_pane.esc_interrupt_hint_visible());
+    assert_matches!(op_rx.try_recv(), Err(TryRecvError::Empty));
+
+    // Running reply: first Esc arms the window and shows the hint.
+    chat.bottom_pane.set_task_running(/*running*/ true);
+    chat.handle_main_esc_press();
+    assert!(chat.esc_interrupt_active());
+    assert!(chat.bottom_pane.esc_interrupt_hint_visible());
+    assert_matches!(op_rx.try_recv(), Err(TryRecvError::Empty));
+
+    // A repeated/released key does not count as the second press.
+    chat.handle_main_esc_press();
+    next_interrupt_op(&mut op_rx);
+    assert!(!chat.esc_interrupt_active());
+
+    // Re-arm, then second Esc stops the reply.
+    chat.handle_main_esc_press();
+    assert!(chat.esc_interrupt_active());
+    chat.handle_main_esc_press();
+    next_interrupt_op(&mut op_rx);
+    assert!(!chat.esc_interrupt_active());
+    assert!(!chat.bottom_pane.esc_interrupt_hint_visible());
+    assert_matches!(rx.try_recv(), Err(TryRecvError::Empty));
+}
