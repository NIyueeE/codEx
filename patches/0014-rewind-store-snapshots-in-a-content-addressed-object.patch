+/// Removes object-store entries no longer referenced by any retained
+/// snapshot manifest, plus leftover temporary files from interrupted writes.
+fn garbage_collect_objects(root: &Path) -> io::Result<()> {
+    let objects_dir = root.join(OBJECTS_DIR_NAME);
+    let mut referenced = HashSet::new();
+    for entry in fs::read_dir(root)?.flatten() {
+        let Some(_index) = entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.parse::<u64>().ok())
+        else {
+            continue;
+        };
+        let Ok(Some(manifest)) = read_manifest(&entry.path()) else {
+            continue;
+        };
+        for file in manifest.files {
+            if let Some(object) = file.object {
+                referenced.insert(object);
+            }
+        }
