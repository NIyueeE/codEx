+#[test]
+fn legacy_manifest_without_object_field_is_restorable() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let root = snapshots_root(codex_home.path(), workspace.path());
+    // Recreate the pre-object-engine layout: snapshot one holds a physical
+    // copy, snapshot two deduplicated the entry and has no physical file.
+    let first_dir = root.join("000001");
+    let second_dir = root.join("000002");
+    fs::create_dir_all(first_dir.join(FILES_DIR_NAME)).expect("first files dir");
+    fs::create_dir_all(second_dir.join(FILES_DIR_NAME)).expect("second files dir");
+    fs::write(first_dir.join(FILES_DIR_NAME).join("legacy.txt"), b"legacy").expect("legacy copy");
+    let metadata =
+        fs::metadata(first_dir.join(FILES_DIR_NAME).join("legacy.txt")).expect("legacy metadata");
+    let manifest = SnapshotManifest {
+        version: MANIFEST_VERSION,
+        created_at: 0,
+        prompt: "legacy".to_string(),
+        files: vec![SnapshotFileEntry {
+            path: "legacy.txt".to_string(),
+            size: metadata.len(),
+            mtime_ns: mtime_nanos(&metadata).expect("mtime"),
+            object: None,
+        }],
+    };
+    write_manifest(&first_dir, &manifest).expect("first manifest");
+    write_manifest(&second_dir, &manifest).expect("second manifest");
+
+    let restored = restore_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        /*index*/ 2,
+        /*respect_gitignore*/ true,
+    )
+    .expect("restore legacy snapshot");
+    assert_eq!(restored, 1);
+    assert_eq!(
+        fs::read(workspace.path().join("legacy.txt")).expect("read"),
+        b"legacy"
+    );
+}
