+#[test]
+fn prune_garbage_collects_unreferenced_objects() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let changing = write_file(workspace.path(), "changing.txt", b"c0");
+    let stable = write_file(workspace.path(), "stable.txt", b"stable");
+    for index in 1..=MAX_SNAPSHOTS + 2 {
+        fs::write(&changing, format!("c{index}")).expect("write changing");
+        take_snapshot(
+            codex_home.path(),
+            workspace.path(),
+            &format!("message {index}"),
+            /*respect_gitignore*/ true,
+        )
+        .expect("snapshot");
+    }
+
+    let root = snapshots_root(codex_home.path(), workspace.path());
+    // Retained snapshots reference the stable object plus the final
+    // MAX_SNAPSHOTS changing contents; the first two changing contents were
+    // pruned and their objects garbage-collected.
+    let object_files = fs::read_dir(root.join(OBJECTS_DIR_NAME))
+        .expect("objects dir")
+        .flatten()
+        .count();
+    assert_eq!(object_files, MAX_SNAPSHOTS + 1);
+    assert_eq!(fs::metadata(&stable).expect("stable file").len(), 6);
+    let snapshots = list_snapshots(codex_home.path(), workspace.path());
+    assert_eq!(snapshots.len(), MAX_SNAPSHOTS);
+}
