+#[test]
+fn snapshot_lock_blocks_live_owner_and_takes_over_stale_lock() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "file.txt", b"data");
+    let root = snapshots_root(codex_home.path(), workspace.path());
+    fs::create_dir_all(&root).expect("snapshots root");
+    let lock_dir = root.join(LOCK_DIR_NAME);
+    fs::create_dir(&lock_dir).expect("create lock");
+
+    // A live owner blocks the snapshot.
+    fs::write(lock_dir.join(LOCK_PID_FILE), std::process::id().to_string())
+        .expect("write live pid");
+    let err = take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "blocked",
+        /*respect_gitignore*/ true,
+    )
+    .expect_err("a live lock should block snapshotting");
+    assert!(err.to_string().contains("lock"), "unexpected error: {err}");
+
+    // A dead owner's lock is taken over and released afterwards.
+    fs::write(lock_dir.join(LOCK_PID_FILE), "999999999").expect("write dead pid");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "taken over",
+        /*respect_gitignore*/ true,
+    )
+    .expect("a stale lock should be taken over");
+    assert!(!lock_dir.exists(), "the lock should be released after use");
+}
