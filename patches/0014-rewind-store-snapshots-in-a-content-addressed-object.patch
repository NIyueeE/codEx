+#[test]
+fn take_snapshot_deduplicates_content_across_snapshots() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"v1");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "one",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot one");
+    fs::write(&file, b"v2").expect("modify");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "two",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot two");
+    fs::write(&file, b"v1").expect("revert content");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "three",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot three");
+
+    let root = snapshots_root(codex_home.path(), workspace.path());
+    let object_files = fs::read_dir(root.join(OBJECTS_DIR_NAME))
+        .expect("objects dir")
+        .flatten()
+        .count();
+    assert_eq!(
+        object_files, 2,
+        "each distinct content should be stored exactly once"
+    );
+    // Snapshots one and three hold the same content and share one object.
+    let first = fs::metadata(root.join("000001/files/notes.txt")).expect("snapshot one copy");
+    let third = fs::metadata(root.join("000003/files/notes.txt")).expect("snapshot three copy");
+    assert_eq!(
+        first.ino(),
+        third.ino(),
+        "identical content should hardlink to the same object"
+    );
+    assert_ne!(
+        first.ino(),
+        fs::metadata(root.join("000002/files/notes.txt"))
+            .expect("snapshot two copy")
+            .ino(),
+        "different content should use a different object"
+    );
+}
