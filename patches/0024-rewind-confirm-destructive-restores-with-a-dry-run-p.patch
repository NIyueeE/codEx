+#[test]
+fn preview_restore_counts_restores_and_deletes() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"v1");
+    take(codex_home.path(), workspace.path(), "one");
+    // Workspace drifts: the tracked file is modified and a new file appears.
+    fs::write(&file, b"v2").expect("modify");
+    write_file(workspace.path(), "extra.txt", b"extra");
+
+    let preview = preview_restore(
+        codex_home.path(),
+        workspace.path(),
+        TEST_THREAD,
+        /*index*/ 1,
+        /*respect_gitignore*/ true,
+    )
+    .expect("preview");
+    assert_eq!(
+        preview,
+        RestorePreview {
+            restore_count: 1,
+            delete_count: 1,
+        }
+    );
+    // The preview must not touch the workspace.
+    assert_eq!(fs::read(&file).expect("read"), b"v2");
+    assert!(workspace.path().join("extra.txt").exists());
+}
