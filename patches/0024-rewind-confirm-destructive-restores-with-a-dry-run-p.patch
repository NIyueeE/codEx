+/// Dry-run preview of restoring snapshot `index`: counts how many files would
+/// be copied back and how many would be deleted, without touching the
+/// workspace. Used to confirm a rewind before applying it.
+pub(crate) fn preview_restore(
+    codex_home: &Path,
+    cwd: &Path,
+    thread_id: &str,
+    index: u64,
+    respect_gitignore: bool,
+) -> io::Result<RestorePreview> {
+    let root = snapshots_root(codex_home, cwd);
+    let chain_root = snapshot_chain_dir(&root, thread_id);
+    let snapshot_dir = chain_root.join(format!("{index:06}"));
+    let manifest = read_manifest(&snapshot_dir)?.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("snapshot {index} does not exist"),
+        )
+    })?;
+
+    let mut restore_count = 0;
+    for entry in &manifest.files {
+        let target = cwd.join(&entry.path);
+        let differs = match fs::metadata(&target) {
+            Ok(metadata) => {
+                let same_size = metadata.len() == entry.size;
+                let same_mtime = mtime_nanos(&metadata)
+                    .map(|mtime| mtime == entry.mtime_ns)
+                    .unwrap_or(false);
+                !(same_size && same_mtime)
+            }
+            Err(_) => true,
+        };
+        if differs {
+            restore_count += 1;
+        }
+    }
+
+    let manifest_paths = manifest
+        .files
+        .iter()
+        .map(|entry| entry.path.as_str())
+        .collect::<BTreeSet<_>>();
+    let mut delete_count = 0;
+    for entry in workspace_walker(cwd, respect_gitignore, Some(&root)) {
+        let Ok(entry) = entry else {
+            continue;
+        };
+        if !entry
+            .file_type()
+            .is_some_and(|file_type| file_type.is_file())
+        {
+            continue;
+        }
+        let Ok(relative) = entry.path().strip_prefix(cwd) else {
+            continue;
+        };
+        let relative_string = relative.to_string_lossy().replace('\\', "/");
+        if is_ignored_path(&relative_string) || manifest_paths.contains(relative_string.as_str()) {
+            continue;
+        }
+        delete_count += 1;
+    }
+    Ok(RestorePreview {
+        restore_count,
+        delete_count,
+    })
+}
+
 fn workspace_walker(
     cwd: &Path,
     respect_gitignore: bool,
