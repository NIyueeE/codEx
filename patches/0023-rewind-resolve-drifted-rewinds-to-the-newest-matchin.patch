+#[test]
+fn rewind_fork_chain_resolves_against_parent_snapshots() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"v1");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        TEST_THREAD,
+        "first question",
+        /*respect_gitignore*/ true,
+        DEFAULT_MAX_SNAPSHOTS,
+    )
+    .expect("a1");
+    fs::write(&file, b"v2").expect("modify");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        TEST_THREAD,
+        "second question",
+        /*respect_gitignore*/ true,
+        DEFAULT_MAX_SNAPSHOTS,
+    )
+    .expect("a2");
+    fs::write(&file, b"v3").expect("modify");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        TEST_THREAD,
+        "third question",
+        /*respect_gitignore*/ true,
+        DEFAULT_MAX_SNAPSHOTS,
+    )
+    .expect("a3");
+
+    // A /rewind fork starts a fresh conversation whose chain has no snapshots
+    // for the replayed messages. After the restored prompt is re-submitted,
+    // the new chain holds one snapshot.
+    let fork_thread = OTHER_THREAD;
+    fs::write(&file, b"v2b").expect("modify");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        fork_thread,
+        "second question",
+        /*respect_gitignore*/ true,
+        DEFAULT_MAX_SNAPSHOTS,
+    )
+    .expect("fork snapshot");
+
+    // Rewinding to a message that predates the fork: the fork chain has no
+    // match, and the workspace-wide store resolves to the parent snapshot.
+    let fork_chain = list_snapshots(codex_home.path(), workspace.path(), fork_thread);
+    assert_eq!(
+        resolve_snapshot_for_message(&fork_chain, /*expected_index*/ 1, "first question")
+            .map(|snapshot| (snapshot.thread_id, snapshot.index)),
+        None,
+        "the fork chain has no snapshot for the replayed first message"
+    );
+    let workspace_snapshots = list_workspace_snapshots(codex_home.path(), workspace.path());
+    let resolved = resolve_snapshot_for_message(
+        &workspace_snapshots,
+        /*expected_index*/ 1,
+        "first question",
+    )
+    .expect("workspace fallback should resolve the parent snapshot");
+    assert_eq!(resolved.thread_id, TEST_THREAD);
+    assert_eq!(resolved.index, 1);
+    let restored = restore_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        &resolved.thread_id,
+        resolved.index,
+        /*respect_gitignore*/ true,
+    )
+    .expect("restore parent snapshot");
+    assert_eq!(restored, 1);
+    assert_eq!(fs::read(&file).expect("read"), b"v1");
+
+    // Rewinding to the post-fork message resolves inside the fork chain.
+    let resolved =
+        resolve_snapshot_for_message(&fork_chain, /*expected_index*/ 1, "second question")
+            .expect("fork chain should resolve its own snapshot");
+    assert_eq!(resolved.thread_id, fork_thread);
+    assert_eq!(resolved.index, 1);
+}
