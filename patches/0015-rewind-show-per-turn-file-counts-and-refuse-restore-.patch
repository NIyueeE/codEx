From 2056ae4be9dbf5aaef94eae1bbd94c1844e44996 Mon Sep 17 00:00:00 2001
From: codEx Fork Bot <codex-fork-bot@localhost>
Date: Wed, 12 Aug 2026 21:57:54 +0800
Subject: rewind: show per-turn file counts and refuse restore while running

- The Files only picker now reports how many file paths each snapshot
  changed relative to the previous one, mirroring opencode's per-turn
  change attribution.
- File restore is rejected while a task is running, matching opencode's
  revert safety guard, so a restore can never race the agent's writes.
---
 codex-rs/tui/src/chatwidget.rs     |  8 +++++++-
 codex-rs/tui/src/rewind/actions.rs | 17 ++++++++++++++++-
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/codex-rs/tui/src/chatwidget.rs b/codex-rs/tui/src/chatwidget.rs
index e08bfb0..16c9c4e 100644
--- a/codex-rs/tui/src/chatwidget.rs
+++ b/codex-rs/tui/src/chatwidget.rs
@@ -1679,9 +1679,15 @@ impl ChatWidget {
         self.bottom_pane.composer_is_empty()
     }
 
+    /// Whether a task (agent turn, review, or other cancellable work) is
+    /// currently running.
+    pub(crate) fn is_task_running(&self) -> bool {
+        self.bottom_pane.is_task_running()
+    }
+
     #[cfg(test)]
     pub(crate) fn is_task_running_for_test(&self) -> bool {
-        self.bottom_pane.is_task_running()
+        self.is_task_running()
     }
 
     pub(crate) fn toggle_vim_mode_and_notify(&mut self) {
diff --git a/codex-rs/tui/src/rewind/actions.rs b/codex-rs/tui/src/rewind/actions.rs
index e7d8649..60bc511 100644
--- a/codex-rs/tui/src/rewind/actions.rs
+++ b/codex-rs/tui/src/rewind/actions.rs
@@ -68,6 +68,16 @@ impl App {
 
     /// Restores workspace files from snapshot `index`.
     pub(crate) fn rewind_restore_snapshot(&mut self, index: u64) {
+        // Like opencode's revert flow, refuse to touch the workspace while a
+        // turn is running: restoring mid-turn would race the agent's writes
+        // and interleave file states.
+        if self.chat_widget.is_task_running() {
+            self.chat_widget.add_error_message(
+                "Cannot restore files while a task is running. Wait for the turn to finish, then try again."
+                    .to_string(),
+            );
+            return;
+        }
         match rewind::restore_snapshot(
             self.config.codex_home.as_path(),
             self.config.cwd.as_path(),
@@ -163,5 +173,10 @@ fn snapshot_label(snapshot: &rewind::RewindSnapshotInfo) -> String {
     let timestamp = chrono::DateTime::from_timestamp(snapshot.created_at, /*nsecs*/ 0)
         .map(|dt| dt.format("%Y-%m-%d %H:%M").to_string())
         .unwrap_or_else(|| "unknown time".to_string());
-    format!("{timestamp} — {}", snapshot.prompt)
+    let files = match snapshot.changed_file_count {
+        0 => "no file changes".to_string(),
+        1 => "1 file changed".to_string(),
+        count => format!("{count} files changed"),
+    };
+    format!("{timestamp} — {} · {files}", snapshot.prompt)
 }
