+#[test]
+fn restore_older_snapshot_restores_deduplicated_files() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"v1");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "one",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot one");
+    // The unchanged file is deduplicated: snapshot two only records a
+    // manifest entry and holds no physical copy.
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "two",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot two");
+    fs::write(&file, b"v3").expect("modify");
+    take_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        "three",
+        /*respect_gitignore*/ true,
+    )
+    .expect("snapshot three");
+
+    // Restoring the middle snapshot must recover the deduplicated content from
+    // the chain instead of silently leaving the current "v3" content in place.
+    let restored = restore_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        /*index*/ 2,
+        /*respect_gitignore*/ true,
+    )
+    .expect("restore snapshot two");
+    assert_eq!(restored, 1);
+    assert_eq!(
+        fs::read(&file).expect("read notes.txt"),
+        b"v1",
+        "deduplicated file content should be resolved from the snapshot chain"
+    );
+}
