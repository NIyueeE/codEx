+/// Finds the newest snapshot at or below `index` that holds a physical copy of
+/// `relative` in its `files/` directory.
+///
+/// Incremental snapshots only record unchanged files in their manifest; the
+/// content for such an entry lives in the most recent older snapshot that
+/// copied the file. A size check guards against truncated or corrupted copies.
+fn find_snapshot_file(
+    root: &Path,
+    index: u64,
+    relative: &str,
+    expected_size: u64,
+) -> Option<PathBuf> {
+    (1..=index).rev().find_map(|candidate| {
+        let path = root
+            .join(format!("{candidate:06}"))
+            .join(FILES_DIR_NAME)
+            .join(relative);
+        fs::metadata(&path)
+            .ok()
+            .filter(|metadata| metadata.is_file() && metadata.len() == expected_size)
+            .map(|_| path)
+    })
+}
+
+/// Resolves the snapshot to restore for a conversation rewind.
+///
+/// Prefers the snapshot numbered `expected_index` (the transcript-ordinal
+/// mapping) when it also carries the selected prompt excerpt. Otherwise picks
+/// the snapshot whose prompt matches and whose index is closest to
+/// `expected_index`, breaking ties toward the newer snapshot so duplicate
+/// prompts resolve to their latest submission. Returns `None` when no snapshot
+/// matches the prompt.
+pub(crate) fn resolve_snapshot_for_message(
+    snapshots: &[RewindSnapshotInfo],
+    expected_index: u64,
+    prompt: &str,
+) -> Option<u64> {
+    let expected_prompt = prompt_excerpt(prompt);
+    snapshots
+        .iter()
+        .find(|snapshot| snapshot.index == expected_index && snapshot.prompt == expected_prompt)
+        .or_else(|| {
+            snapshots
+                .iter()
+                .filter(|snapshot| snapshot.prompt == expected_prompt)
+                .min_by_key(|snapshot| {
+                    (
+                        snapshot.index.abs_diff(expected_index),
+                        Reverse(snapshot.index),
+                    )
+                })
+        })
+        .map(|snapshot| snapshot.index)
+}
