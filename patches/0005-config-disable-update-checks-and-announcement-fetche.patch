-        Windows,
-        #[serde(other)]
-        Unknown,
-    }
-
-    impl TargetOs {
-        const fn current() -> Self {
-            if cfg!(target_os = "macos") {
-                Self::Macos
-            } else if cfg!(target_os = "windows") {
-                Self::Windows
-            } else {
