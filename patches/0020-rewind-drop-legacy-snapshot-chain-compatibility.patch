+    let snapshots = vec![
+        RewindSnapshotInfo {
+            thread_id: TEST_THREAD.to_string(),
+            index: 1,
+            created_at: 0,
+            prompt: "first".to_string(),
+            changed_file_count: 1,
+        },
+        RewindSnapshotInfo {
+            thread_id: TEST_THREAD.to_string(),
+            index: 2,
+            created_at: 0,
+            prompt: "(side question)".to_string(),
+            changed_file_count: 1,
+        },
+        RewindSnapshotInfo {
+            thread_id: TEST_THREAD.to_string(),
+            index: 3,
+            created_at: 0,
+            prompt: "first".to_string(),
+            changed_file_count: 1,
+        },
+    ];
+    // The expected index 2 was consumed by an unrelated snapshot; the closest
+    // matching snapshot (index 3, tie broken toward newer) wins.
+    assert_eq!(
+        resolve_snapshot_for_message(&snapshots, /*expected_index*/ 2, "first"),
+        Some(3)
+    );
+    assert_eq!(
+        resolve_snapshot_for_message(&snapshots, /*expected_index*/ 4, "first"),
+        Some(3)
+    );
+    assert_eq!(
+        resolve_snapshot_for_message(&snapshots, /*expected_index*/ 2, "absent"),
+        None
+    );
+    assert_eq!(
+        resolve_snapshot_for_message(&[], /*expected_index*/ 1, "first"),
+        None
