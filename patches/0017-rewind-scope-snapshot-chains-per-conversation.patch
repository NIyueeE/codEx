+#[test]
+fn thread_snapshots_are_isolated_per_conversation() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"base");
+    let thread_a = "11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+    let thread_b = "22222222-bbbb-4bbb-8bbb-bbbbbbbbbbbb";
+
+    // Two conversations in the same workspace each start their chain at 1.
+    take_thread_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        thread_a,
+        "a one",
+        /*respect_gitignore*/ true,
+        MAX_SNAPSHOTS,
+    )
+    .expect("snapshot a1");
+    take_thread_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        thread_b,
+        "b one",
+        /*respect_gitignore*/ true,
+        MAX_SNAPSHOTS,
+    )
+    .expect("snapshot b1");
+    fs::write(&file, b"change").expect("modify");
+    take_thread_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        thread_a,
+        "a two",
+        /*respect_gitignore*/ true,
+        MAX_SNAPSHOTS,
+    )
+    .expect("snapshot a2");
+
+    let a = list_thread_snapshots(codex_home.path(), workspace.path(), thread_a);
+    assert_eq!(
+        a.iter().map(|snapshot| snapshot.index).collect::<Vec<_>>(),
+        vec![1, 2]
+    );
+    assert!(a.iter().all(|snapshot| snapshot.thread_id == thread_a));
+    let b = list_thread_snapshots(codex_home.path(), workspace.path(), thread_b);
+    assert_eq!(
+        b.iter().map(|snapshot| snapshot.index).collect::<Vec<_>>(),
+        vec![1]
+    );
+    assert!(b.iter().all(|snapshot| snapshot.thread_id == thread_b));
+
+    // The workspace-wide list aggregates both conversation chains.
+    let all = list_workspace_snapshots(codex_home.path(), workspace.path());
+    assert_eq!(all.len(), 3);
+    assert!(all.iter().any(|snapshot| snapshot.thread_id == thread_a));
+    assert!(all.iter().any(|snapshot| snapshot.thread_id == thread_b));
+
+    // Restore resolves within the conversation's own chain.
+    fs::write(&file, b"after").expect("modify");
+    let restored = restore_thread_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        thread_a,
+        /*index*/ 1,
+        /*respect_gitignore*/ true,
+    )
+    .expect("restore thread a snapshot 1");
+    assert_eq!(restored, 1);
+    assert_eq!(fs::read(&file).expect("read"), b"base");
+}
