+#[test]
+fn thread_chains_prune_independently_and_gc_keeps_referenced_objects() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"base");
+    let thread_a = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+    let thread_b = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb";
+    for index in 1..=MAX_SNAPSHOTS + 5 {
+        fs::write(&file, format!("a{index}")).expect("modify");
+        take_thread_snapshot(
+            codex_home.path(),
+            workspace.path(),
+            thread_a,
+            &format!("a {index}"),
+            /*respect_gitignore*/ true,
+            MAX_SNAPSHOTS,
+        )
+        .expect("thread a snapshot");
+    }
+    take_thread_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        thread_b,
+        "b one",
+        /*respect_gitignore*/ true,
+        MAX_SNAPSHOTS,
+    )
+    .expect("thread b snapshot");
+
+    // Thread A kept its own most recent MAX_SNAPSHOTS; thread B is untouched.
+    let a = list_thread_snapshots(codex_home.path(), workspace.path(), thread_a);
+    assert_eq!(a.len(), MAX_SNAPSHOTS);
+    assert_eq!(a[0].index, 6);
+    let b = list_thread_snapshots(codex_home.path(), workspace.path(), thread_b);
+    assert_eq!(b.len(), 1);
+    assert_eq!(b[0].index, 1);
+
+    // Objects referenced by either retained chain survive; the pruned
+    // contents a1..a5 are garbage-collected.
+    let root = snapshots_root(codex_home.path(), workspace.path());
+    let object_files = fs::read_dir(root.join(OBJECTS_DIR_NAME))
+        .expect("objects dir")
+        .flatten()
+        .count();
+    assert_eq!(object_files, MAX_SNAPSHOTS);
+}
