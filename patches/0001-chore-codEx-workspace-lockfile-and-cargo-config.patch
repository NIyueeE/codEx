diff --git a/codex-rs/.cargo/audit.toml b/codex-rs/.cargo/audit.toml
index 4abf907b90198f967829a7c70d88cb7c2227adef..d2a06a1009dc826ecf2fa3ccf19ef4c67e649c4f 100644
--- a/codex-rs/.cargo/audit.toml
+++ b/codex-rs/.cargo/audit.toml
@@ -6,7 +6,6 @@ ignore = [
     "RUSTSEC-2025-0057", # fxhash 0.2.1 via starlark_map/bm25; upstream crate is unmaintained
     "RUSTSEC-2024-0436", # paste 1.0.15 via starlark/v8; upstream crate is unmaintained
     "RUSTSEC-2023-0089", # atomic-polyfill via postcard/heapless/pagable; upstream crate is unmaintained
-    "RUSTSEC-2024-0320", # yaml-rust via syntect; remove when syntect drops or updates it
     "RUSTSEC-2025-0141", # bincode via syntect; remove when syntect drops or updates it
     "RUSTSEC-2026-0118", # hickory-proto via rama-dns/rama-tcp; remove when rama updates to hickory 0.26.1 or hickory-net
     "RUSTSEC-2026-0119", # hickory-proto via rama-dns/rama-tcp; remove when rama updates to hickory 0.26.1 or hickory-net
@@ -22,7 +21,6 @@ ignore = [
     "RUSTSEC-2026-0391", # Codex, tonic and zip use zstd 0.13.3 without reusing borrowed contexts across streams. Remove when all paths use zstd >=0.14.3.
     "RUSTSEC-2026-0398", # zstd 0.13.3 pulls in zstd-safe 7.2.4 with the affected seekable feature disabled. Remove when all paths use zstd-safe >=8.2.0.
     "RUSTSEC-2026-0403", # zstd 0.13.3 pulls in zstd-safe 7.2.4. Codex, tonic and zip use read decoders or initialized output buffers and discard output on error. Remove when all paths use zstd-safe >=8.2.0.
-    "RUSTSEC-2026-0410", # zstd-safe 7.2.4 pulls in zstd-sys 2.0.16. Its allocator bug only affects wasm32, and Codex ships native binaries. Remove when the lockfile uses zstd-sys >=2.1.2.
     # Reviewed 2026-10-29.
-    "RUSTSEC-2026-0418", # libz-sys 1.1.29 via curl-sys/curl in codex-http-client is Windows-only and skips the affected probe; cc is locked to 1.2.55 (<1.6.0). Remove when libz-sys >=1.1.31; reassess if used on Unix with cc >=1.6.0.
 ]
+    "RUSTSEC-2026-0441", # pin-utils 0.1.0 via aws-smithy-http/runtime/types under codex-aws-auth and via loom under tokio-graceful (dev-dep only). Archived upstream 2026-10-01 with no fixed release. Remove when the AWS SDK or tokio-graceful drops it.
diff --git a/codex-rs/.config/nextest.toml b/codex-rs/.config/nextest.toml
index 0dd671758ee0f1b70c788463f86929f2330106fc..296edab9e099eb198cec2f48eb1925ec05925331 100644
--- a/codex-rs/.config/nextest.toml
+++ b/codex-rs/.config/nextest.toml
@@ -56,6 +56,13 @@ max-threads = 2
 filter = 'test(rmcp_client) | test(humanlike_typing_1000_chars_appears_live_no_placeholder)'
 slow-timeout = { period = "1m", terminate-after = 4 }
 
+[[profile.default.overrides]]
+# Upstream 0.164.0 expanded this case to exercise the compaction retry path
+# over a 300-item, 2 MB+ history, which takes just over the default 60 s budget
+# on a single host running the whole suite. It passes in ~64 s in isolation.
+filter = 'package(codex-core) & test(local_compaction_retries_preserve_instructions_and_tool_metadata)'
+slow-timeout = { period = "1m", terminate-after = 2 }
+
 [[profile.default.overrides]]
 # This end-to-end case launches several CLI subprocesses and checks cloud policy.
 filter = 'package(codex-exec) & test(worktree_start_and_fork_use_host_pool_and_preserve_legacy_resume)'
