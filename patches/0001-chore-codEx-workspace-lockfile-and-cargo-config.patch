diff --git a/codex-rs/.config/nextest.toml b/codex-rs/.config/nextest.toml
index 0dd671758ee0f1b70c788463f86929f2330106fc..296edab9e099eb198cec2f48eb1925ec05925331 100644
--- a/codex-rs/.config/nextest.toml
+++ b/codex-rs/.config/nextest.toml
@@ -56,6 +56,13 @@ max-threads = 2
 filter = 'test(rmcp_client) | test(humanlike_typing_1000_chars_appears_live_no_placeholder)'
 slow-timeout = { period = "1m", terminate-after = 4 }
 
+[[profile.default.overrides]]
+# Upstream 0.164.0 expanded this case to exercise the compaction retry path
+# over a 300-item, 2 MB+ history, which takes just over the default 60 s budget
+# on a single host running the whole suite. It passes in ~64 s in isolation.
+filter = 'package(codex-core) & test(local_compaction_retries_preserve_instructions_and_tool_metadata)'
+slow-timeout = { period = "1m", terminate-after = 2 }
+
 [[profile.default.overrides]]
 # This end-to-end case launches several CLI subprocesses and checks cloud policy.
 filter = 'package(codex-exec) & test(worktree_start_and_fork_use_host_pool_and_preserve_legacy_resume)'
