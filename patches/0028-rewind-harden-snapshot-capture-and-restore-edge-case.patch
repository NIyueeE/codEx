+fn interrupted_snapshot_directories_are_pruned() {
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    write_file(workspace.path(), "file.txt", b"data");
+    take(codex_home.path(), workspace.path(), "one");
+
+    let chain = thread_root(codex_home.path(), workspace.path(), TEST_THREAD);
+    fs::create_dir_all(chain.join("000002/files")).expect("simulate interrupted snapshot");
+    take(codex_home.path(), workspace.path(), "two");
+
+    assert!(
+        !chain.join("000002").exists(),
+        "interrupted snapshot directories are removed during pruning"
+    );
+    let snapshots = list_snapshots(codex_home.path(), workspace.path(), TEST_THREAD);
+    assert_eq!(
+        snapshots.iter().map(|info| info.index).collect::<Vec<_>>(),
+        vec![1, 3]
+    );
+}
