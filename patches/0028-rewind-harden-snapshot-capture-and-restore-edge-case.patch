+#[test]
+fn resolve_workspace_snapshot_for_message_declines_ambiguous_threads() {
+    let shared = info(
+        TEST_THREAD,
+        3,
+        "continue",
+        Some(prompt_hash_hex("continue")),
+    );
+    let other = info(
+        OTHER_THREAD,
+        3,
+        "continue",
+        Some(prompt_hash_hex("continue")),
+    );
+    assert_eq!(
+        resolve_workspace_snapshot_for_message(&[shared, other], 3, "continue"),
+        None,
+        "two conversations carrying the same prompt must not resolve"
+    );
+
+    let single = vec![
+        info(
+            TEST_THREAD,
+            1,
+            "continue",
+            Some(prompt_hash_hex("continue")),
+        ),
+        info(
+            TEST_THREAD,
+            3,
+            "continue",
+            Some(prompt_hash_hex("continue")),
+        ),
+    ];
+    assert_eq!(
+        resolve_workspace_snapshot_for_message(&single, 3, "continue"),
+        Some((TEST_THREAD.to_string(), 3)),
+        "a single matching conversation resolves by index"
+    );
+}
