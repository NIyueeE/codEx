+/// Copies `source` over `target` atomically: content is written to a fresh
+/// temporary file next to the target and renamed into place. The rename
+/// replaces a symbolic link at the target instead of writing through it, and
+/// replaces read-only files without an open-for-write on the target itself.
+fn copy_over_atomic(source: &Path, target: &Path, sequence: usize) -> io::Result<()> {
+    let target_dir = target.parent().ok_or_else(|| {
+        io::Error::new(
