+#[test]
+fn restore_replaces_read_only_targets() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let codex_home = tempfile::tempdir().expect("codex home");
+    let workspace = tempfile::tempdir().expect("workspace");
+    let file = write_file(workspace.path(), "notes.txt", b"v1");
+    take(codex_home.path(), workspace.path(), "one");
+    fs::write(&file, b"v2").expect("modify");
+    let mut perms = fs::metadata(&file).expect("metadata").permissions();
+    perms.set_mode(0o444);
+    fs::set_permissions(&file, perms).expect("chmod 444");
+
+    restore_snapshot(codex_home.path(), workspace.path(), TEST_THREAD, 1)
+        .expect("restore over a read-only target");
+    assert_eq!(fs::read(&file).expect("read"), b"v1");
+}
