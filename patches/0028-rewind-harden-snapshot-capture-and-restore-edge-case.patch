+#[test]
+fn resolve_snapshot_for_message_uses_full_prompt_hash() {
+    let shared_prefix = "x".repeat(300);
+    let prompt_a = format!("{shared_prefix} END-A");
+    let prompt_b = format!("{shared_prefix} END-B");
+    let snapshots = vec![
+        info(TEST_THREAD, 1, &prompt_a, Some(prompt_hash_hex(&prompt_a))),
+        info(TEST_THREAD, 2, &prompt_b, Some(prompt_hash_hex(&prompt_b))),
+    ];
+    // The 200-character excerpts are identical, so only the full-prompt hash
+    // can tell the two snapshots apart.
+    assert_eq!(prompt_excerpt(&prompt_a), prompt_excerpt(&prompt_b));
+    assert_eq!(
+        resolve_snapshot_for_message(&snapshots, 2, &prompt_b).map(|info| info.index),
+        Some(2)
+    );
+}
