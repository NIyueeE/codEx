+#[tokio::test]
+async fn rewind_defaults_on_and_respects_gitignore() -> std::io::Result<()> {
+    let codex_home = TempDir::new()?;
+    let config = ConfigBuilder::default()
+        .codex_home(codex_home.path().to_path_buf())
+        .build()
+        .await?;
+    assert!(config.rewind_enabled);
+    assert!(config.rewind_respect_gitignore);
+    Ok(())
+}
+
+#[tokio::test]
+async fn rewind_can_be_disabled_in_config() -> std::io::Result<()> {
+    let codex_home = TempDir::new()?;
+    std::fs::write(
+        codex_home.path().join(CONFIG_TOML_FILE),
+        r#"
+rewind_enabled = false
+rewind_respect_gitignore = false
+"#,
+    )?;
+    let config = ConfigBuilder::default()
+        .codex_home(codex_home.path().to_path_buf())
+        .build()
