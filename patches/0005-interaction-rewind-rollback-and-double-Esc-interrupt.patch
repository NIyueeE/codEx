+//! `/rewind` UI actions: scope picker, message picker, snapshot picker, and
+//! file restoration. The file snapshot engine lives in [`super`].
+
+use crate::app::App;
+use crate::app_backtrack::BacktrackSelection;
+use crate::app_event::AppEvent;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::popup_consts::standard_popup_hint_line;
+use crate::rewind;
+
+const REWIND_TITLE: &str = "Rewind";
+const NO_MESSAGES_TO_REWIND: &str = "No previous messages to rewind.";
+const NO_SNAPSHOTS_TO_REWIND: &str =
+    "No file snapshots yet. Snapshots are taken before each turn when /rewind is enabled.";
+
+impl App {
+    /// Shows the `/rewind` scope picker.
+    pub(crate) fn show_rewind_scope_picker(&mut self) {
+        self.chat_widget
+            .show_selection_view(rewind_scope_selection_params());
+    }
+
+    /// Shows the searchable message picker for conversation rollback.
+    pub(crate) fn show_rewind_message_picker(&mut self, restore_files: bool) {
+        let selections = self.rewind_message_selections();
+        if selections.is_empty() {
+            self.chat_widget
+                .add_info_message(NO_MESSAGES_TO_REWIND.to_string(), /*hint*/ None);
+            return;
+        }
+
+        let items = selections
+            .into_iter()
+            .map(|(nth, selection)| {
+                // Snapshots are numbered from 1 (one per submitted user
+                // message, taken before its turn), so the snapshot for message
+                // `nth` (0-based transcript ordinal) is `nth + 1`.
+                let index = nth as u64 + 1;
+                let prompt_text = selection.prompt.text.clone();
+                let thread_id = selection.thread_id;
+                let prompt = selection.prompt.clone();
+                SelectionItem {
+                    name: message_one_line(&selection),
+                    description: Some(format!("Message {}", nth + 1)),
+                    search_value: Some(selection.prompt.text),
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::ForkSessionForPromptEdit {
+                            thread_id,
+                            nth_user_message: nth,
+                            prompt: prompt.clone(),
+                        });
+                        if restore_files {
+                            tx.send(AppEvent::RewindRestoreFiles {
+                                index,
+                                prompt: prompt_text.clone(),
+                            });
+                        }
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect();
+
+        let subtitle = if restore_files {
+            "Pick a message to rewind to; workspace files are restored to that point"
+        } else {
+            "Pick a message to rewind the conversation to"
+        };
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            view_id: Some("rewind_messages"),
+            title: Some(REWIND_TITLE.to_string()),
+            subtitle: Some(subtitle.to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            is_searchable: true,
+            search_placeholder: Some("Search messages".to_string()),
+            items,
+            ..Default::default()
+        });
+    }
+
+    /// Shows the snapshot picker for file-only rollback.
+    pub(crate) fn show_rewind_snapshot_picker(&mut self) {
+        let snapshots =
+            rewind::list_snapshots(self.config.codex_home.as_path(), self.config.cwd.as_path());
+        if snapshots.is_empty() {
+            self.chat_widget
+                .add_info_message(NO_SNAPSHOTS_TO_REWIND.to_string(), /*hint*/ None);
+            return;
+        }
+
+        let items = snapshots
+            .into_iter()
+            .map(|snapshot| SelectionItem {
+                name: format!("Turn {}", snapshot.index),
+                description: Some(snapshot_label(&snapshot)),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::RewindRestoreSnapshot {
+                        index: snapshot.index,
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            })
+            .collect();
+
+        self.chat_widget.show_selection_view(SelectionViewParams {
+            view_id: Some("rewind_snapshots"),
+            title: Some(REWIND_TITLE.to_string()),
+            subtitle: Some("Pick a snapshot to restore workspace files from".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            is_searchable: false,
+            items,
+            ..Default::default()
+        });
+    }
+
+    /// Restores workspace files from snapshot `index`.
+    pub(crate) fn rewind_restore_snapshot(&mut self, index: u64) {
+        match rewind::restore_snapshot(
+            self.config.codex_home.as_path(),
+            self.config.cwd.as_path(),
+            index,
+            self.config.rewind_respect_gitignore,
+        ) {
+            Ok(restored) => {
+                self.chat_widget.add_info_message(
+                    format!("Restored {restored} file(s) from snapshot {index}."),
+                    /*hint*/ None,
+                );
+            }
+            Err(err) => {
+                self.chat_widget
+                    .add_error_message(format!("Failed to restore snapshot {index}: {err}"));
+            }
+        }
+    }
+
+    /// Restores workspace files for a conversation rewind.
+    ///
+    /// `index` is the transcript ordinal of the selected message, which matches
+    /// the snapshot numbering unless submissions and transcript cells drifted;
+    /// the snapshot's recorded prompt is then used as a fallback.
+    pub(crate) fn rewind_restore_files(&mut self, index: u64, prompt: String) {
+        let codex_home = self.config.codex_home.as_path();
+        let cwd = self.config.cwd.as_path();
+        let snapshots = rewind::list_snapshots(codex_home, cwd);
+        let snapshot = snapshots
+            .iter()
+            .find(|snapshot| snapshot.index == index)
+            .or_else(|| {
+                snapshots
+                    .iter()
+                    .rev()
+                    .find(|snapshot| snapshot.prompt == rewind::prompt_excerpt(&prompt))
+            })
+            .or_else(|| snapshots.last());
+        let Some(snapshot) = snapshot else {
+            self.chat_widget
+                .add_error_message("No matching file snapshot found for this message.".to_string());
+            return;
+        };
+        self.rewind_restore_snapshot(snapshot.index);
+    }
+}
+
+/// Builds the `/rewind` scope picker (files and/or conversation rollback).
+pub(crate) fn rewind_scope_selection_params() -> SelectionViewParams {
+    SelectionViewParams {
+        view_id: Some("rewind_scope"),
+        title: Some(REWIND_TITLE.to_string()),
+        subtitle: Some("Choose what to roll back".to_string()),
+        footer_hint: Some(standard_popup_hint_line()),
+        is_searchable: false,
+        items: vec![
+            SelectionItem {
+                name: "Files and conversation".to_string(),
+                description: Some(
+                    "Restore workspace files and fork the chat before a message".to_string(),
+                ),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::OpenRewindMessagePicker {
+                        restore_files: /*restore_files*/ true,
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Conversation only".to_string(),
+                description: Some(
+                    "Fork the chat before a message without touching files".to_string(),
+                ),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::OpenRewindMessagePicker {
+                        restore_files: /*restore_files*/ false,
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Files only".to_string(),
+                description: Some("Restore workspace files from an earlier snapshot".to_string()),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::OpenRewindSnapshotPicker);
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+        ],
+        ..Default::default()
+    }
+}
+
+fn message_one_line(selection: &BacktrackSelection) -> String {
+    let first_line = selection
+        .prompt
+        .text
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .trim();
+    if first_line.is_empty() {
+        return "(attachment)".to_string();
+    }
+    let mut name = first_line.chars().take(90).collect::<String>();
+    if first_line.chars().count() > 90 {
+        name.push('…');
+    }
+    name
+}
+
+fn snapshot_label(snapshot: &rewind::RewindSnapshotInfo) -> String {
+    let timestamp = chrono::DateTime::from_timestamp(snapshot.created_at, /*nsecs*/ 0)
+        .map(|dt| dt.format("%Y-%m-%d %H:%M").to_string())
+        .unwrap_or_else(|| "unknown time".to_string());
+    format!("{timestamp} — {}", snapshot.prompt)
+}
diff --git a/codex-rs/tui/src/rewind/mod.rs b/codex-rs/tui/src/rewind/mod.rs
new file mode 100644
index 0000000..04321ce
--- /dev/null
+++ b/codex-rs/tui/src/rewind/mod.rs
@@ -0,0 +1,374 @@
+//! File snapshots for `/rewind`.
+//!
+//! Before each user turn the TUI snapshots the workspace so the user can roll
+//! back file changes. Snapshots live under
+//! `~/.codex/snapshots/<workspace-hash>/<turn>/`; each snapshot is a plain
+//! directory (no git involved) containing a `manifest.json` and the captured
+//! files under `files/`. The walk excludes `.git` and, by default, respects
+//! `.gitignore` files.
+//!
+//! Snapshots are incremental: files whose size and mtime are unchanged since
+//! the previous snapshot are not copied again. The most recent
+//! [`MAX_SNAPSHOTS`] snapshots are retained per workspace.
+
+use std::collections::BTreeSet;
+use std::fs;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::UNIX_EPOCH;
+
+use ignore::WalkBuilder;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+
+/// Maximum number of snapshots retained per workspace.
+pub(crate) const MAX_SNAPSHOTS: usize = 20;
+/// Manifest format version.
+const MANIFEST_VERSION: u32 = 1;
+/// Prompt excerpt length stored in the manifest.
+const PROMPT_EXCERPT_CHARS: usize = 200;
+
+const MANIFEST_FILE_NAME: &str = "manifest.json";
+const FILES_DIR_NAME: &str = "files";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct SnapshotFileEntry {
+    /// Path relative to the workspace root.
+    pub(crate) path: String,
+    pub(crate) size: u64,
+    pub(crate) mtime_ns: i128,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) struct SnapshotManifest {
+    pub(crate) version: u32,
+    pub(crate) created_at: i64,
+    /// Excerpt of the user message that triggered this snapshot.
+    pub(crate) prompt: String,
+    pub(crate) files: Vec<SnapshotFileEntry>,
+}
+
+/// Metadata about a stored snapshot, used by the `/rewind` pickers.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct RewindSnapshotInfo {
+    pub(crate) index: u64,
+    pub(crate) created_at: i64,
+    pub(crate) prompt: String,
+}
+
+/// Root directory holding snapshots for a workspace.
+pub(crate) fn snapshots_root(codex_home: &Path, cwd: &Path) -> PathBuf {
+    codex_home.join("snapshots").join(workspace_hash(cwd))
+}
+
+fn workspace_hash(cwd: &Path) -> String {
+    let canonical = fs::canonicalize(cwd).unwrap_or_else(|_| cwd.to_path_buf());
+    let digest = Sha256::digest(canonical.to_string_lossy().as_bytes());
+    let mut hex = String::with_capacity(16);
+    for byte in digest.iter().take(8) {
+        hex.push_str(&format!("{byte:02x}"));
+    }
+    hex
+}
+
+/// Takes a snapshot of `cwd` before a user turn.
+///
+/// The snapshot directory is numbered with the next unused index in
+/// `snapshots_root` and files are copied incrementally relative to the
+/// previous snapshot. Returns the path of the new snapshot directory.
+pub(crate) fn take_snapshot(
+    codex_home: &Path,
+    cwd: &Path,
+    prompt: &str,
+    respect_gitignore: bool,
+) -> io::Result<PathBuf> {
+    let root = snapshots_root(codex_home, cwd);
+    fs::create_dir_all(&root)?;
+    let index = next_snapshot_index(&root)?;
+    let snapshot_dir = root.join(format!("{index:06}"));
+    let files_dir = snapshot_dir.join(FILES_DIR_NAME);
+    fs::create_dir_all(&files_dir)?;
+
+    let previous_manifest = previous_snapshot_manifest(&root, index);
+    let previous_files = previous_manifest
+        .as_ref()
+        .map(|manifest| {
+            manifest
+                .files
+                .iter()
+                .map(|entry| (entry.path.as_str(), (entry.size, entry.mtime_ns)))
+                .collect::<std::collections::HashMap<_, _>>()
+        })
+        .unwrap_or_default();
+
+    let mut entries = Vec::new();
+    let snapshot_root = root.clone();
+    for entry in workspace_walker(cwd, respect_gitignore, Some(&snapshot_root)) {
+        let entry = entry.map_err(io::Error::other)?;
+        if !entry
+            .file_type()
+            .is_some_and(|file_type| file_type.is_file())
+        {
+            continue;
+        }
+        let path = entry.path();
+        let relative = path
+            .strip_prefix(cwd)
+            .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+        let relative_string = relative.to_string_lossy().replace('\\', "/");
+        if is_ignored_path(&relative_string) {
+            continue;
+        }
+        let metadata = entry.metadata().map_err(io::Error::other)?;
+        let size = metadata.len();
+        let mtime_ns = mtime_nanos(&metadata)?;
+        if previous_files.get(relative_string.as_str()) == Some(&(size, mtime_ns)) {
+            entries.push(SnapshotFileEntry {
+                path: relative_string,
+                size,
+                mtime_ns,
+            });
+            continue;
+        }
+        let dest = files_dir.join(&relative_string);
+        if let Some(parent) = dest.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        fs::copy(path, &dest)?;
+        entries.push(SnapshotFileEntry {
+            path: relative_string,
+            size,
+            mtime_ns,
+        });
+    }
+    entries.sort_by(|a, b| a.path.cmp(&b.path));
+
+    let manifest = SnapshotManifest {
+        version: MANIFEST_VERSION,
+        created_at: now_unix_seconds(),
+        prompt: prompt_excerpt(prompt),
+        files: entries,
+    };
+    write_manifest(&snapshot_dir, &manifest)?;
+    prune_old_snapshots(&root, MAX_SNAPSHOTS)?;
+    Ok(snapshot_dir)
+}
+
+/// Lists stored snapshots for a workspace, oldest first.
+pub(crate) fn list_snapshots(codex_home: &Path, cwd: &Path) -> Vec<RewindSnapshotInfo> {
+    let root = snapshots_root(codex_home, cwd);
+    let Ok(read_dir) = fs::read_dir(&root) else {
+        return Vec::new();
+    };
+    let mut snapshots = Vec::new();
+    for entry in read_dir.flatten() {
+        let Some(index) = entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.parse::<u64>().ok())
+        else {
+            continue;
+        };
+        let manifest = read_manifest(&entry.path()).ok().flatten();
+        snapshots.push(RewindSnapshotInfo {
+            index,
+            created_at: manifest.as_ref().map(|m| m.created_at).unwrap_or_default(),
+            prompt: manifest.map(|m| m.prompt).unwrap_or_default(),
+        });
+    }
+    snapshots.sort_by_key(|snapshot| snapshot.index);
+    snapshots
+}
+
+/// Restores the workspace to the state captured in snapshot `index`.
+///
+/// Files recorded in the snapshot are copied back (overwriting current
+/// content) and files present in the workspace but absent from the snapshot
+/// are deleted. Returns the number of files restored.
+pub(crate) fn restore_snapshot(
+    codex_home: &Path,
+    cwd: &Path,
+    index: u64,
+    respect_gitignore: bool,
+) -> io::Result<usize> {
+    let snapshot_dir = snapshots_root(codex_home, cwd).join(format!("{index:06}"));
+    let manifest = read_manifest(&snapshot_dir)?.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("snapshot {index} does not exist"),
+        )
+    })?;
+
+    let mut restored = 0;
+    for entry in &manifest.files {
+        let source = snapshot_dir.join(FILES_DIR_NAME).join(&entry.path);
+        let target = cwd.join(&entry.path);
+        if let Some(parent) = target.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        if source.is_file() {
+            fs::copy(&source, &target)?;
+            restored += 1;
+        }
+    }
+
+    let manifest_paths = manifest
+        .files
+        .iter()
+        .map(|entry| entry.path.as_str())
+        .collect::<BTreeSet<_>>();
+    let snapshot_root = snapshots_root(codex_home, cwd);
+    for entry in workspace_walker(cwd, respect_gitignore, Some(&snapshot_root)) {
+        let entry = entry.map_err(io::Error::other)?;
+        if !entry
+            .file_type()
+            .is_some_and(|file_type| file_type.is_file())
+        {
+            continue;
+        }
+        let relative = entry
+            .path()
+            .strip_prefix(cwd)
+            .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+        let relative_string = relative.to_string_lossy().replace('\\', "/");
+        if is_ignored_path(&relative_string) || manifest_paths.contains(relative_string.as_str()) {
+            continue;
+        }
+        fs::remove_file(entry.path())?;
+    }
+
+    Ok(restored)
+}
+
+fn workspace_walker(
+    cwd: &Path,
+    respect_gitignore: bool,
+    exclude_dir: Option<&Path>,
+) -> ignore::Walk {
+    let mut builder = WalkBuilder::new(cwd);
+    builder
+        .hidden(false)
+        .follow_links(false)
+        .git_ignore(respect_gitignore)
+        .git_exclude(false)
+        .git_global(false)
+        .require_git(false);
+    if let Some(exclude_dir) = exclude_dir {
+        let exclude = exclude_dir.to_path_buf();
+        builder.filter_entry(move |entry| {
+            let path = entry.path();
+            path == exclude || !path.starts_with(&exclude)
+        });
+    }
+    builder.build()
+}
+
+fn is_ignored_path(relative: &str) -> bool {
+    relative == ".git" || relative.starts_with(".git/")
+}
+
+fn next_snapshot_index(root: &Path) -> io::Result<u64> {
+    let max_index = fs::read_dir(root)?
+        .flatten()
+        .filter_map(|entry| {
+            entry
+                .file_name()
+                .to_str()
+                .and_then(|name| name.parse::<u64>().ok())
+        })
+        .max()
+        .unwrap_or(0);
+    Ok(max_index.saturating_add(1))
+}
+
+fn previous_snapshot_manifest(root: &Path, current_index: u64) -> Option<SnapshotManifest> {
+    let previous_index = (0..current_index).rev().find(|index| {
+        root.join(format!("{index:06}"))
+            .join(MANIFEST_FILE_NAME)
+            .is_file()
+    })?;
+    read_manifest(&root.join(format!("{previous_index:06}")))
+        .ok()
+        .flatten()
+}
+
+fn read_manifest(snapshot_dir: &Path) -> io::Result<Option<SnapshotManifest>> {
+    let manifest_path = snapshot_dir.join(MANIFEST_FILE_NAME);
+    if !manifest_path.is_file() {
+        return Ok(None);
+    }
+    let contents = fs::read_to_string(&manifest_path)?;
+    serde_json::from_str(&contents)
+        .map(Some)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))
+}
+
+fn write_manifest(snapshot_dir: &Path, manifest: &SnapshotManifest) -> io::Result<()> {
+    let contents = serde_json::to_string_pretty(manifest)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+    fs::write(snapshot_dir.join(MANIFEST_FILE_NAME), contents)
+}
+
+fn prune_old_snapshots(root: &Path, max_snapshots: usize) -> io::Result<()> {
+    let mut indices = fs::read_dir(root)?
+        .flatten()
+        .filter_map(|entry| {
+            entry
+                .file_name()
+                .to_str()
+                .and_then(|name| name.parse::<u64>().ok())
+        })
+        .collect::<Vec<_>>();
+    indices.sort_unstable();
+    let overflow = indices.len().saturating_sub(max_snapshots);
+    for index in indices.into_iter().take(overflow) {
+        let dir = root.join(format!("{index:06}"));
+        if dir.is_dir() {
+            fs::remove_dir_all(&dir)?;
+        }
+    }
+    Ok(())
+}
+
+fn mtime_nanos(metadata: &fs::Metadata) -> io::Result<i128> {
+    let modified = metadata.modified()?;
+    let duration = modified
+        .duration_since(UNIX_EPOCH)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+    Ok(i128::from(duration.as_secs()) * 1_000_000_000 + i128::from(duration.subsec_nanos()))
+}
+
+fn now_unix_seconds() -> i64 {
+    std::time::SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_secs() as i64)
+        .unwrap_or_default()
+}
+
+pub(crate) fn prompt_excerpt(prompt: &str) -> String {
+    let trimmed = prompt.trim();
+    if trimmed.is_empty() {
+        return "(attachment)".to_string();
+    }
+    let mut excerpt = trimmed
+        .chars()
+        .take(PROMPT_EXCERPT_CHARS)
+        .collect::<String>();
+    excerpt.push_str(if trimmed.chars().count() > PROMPT_EXCERPT_CHARS {
+        "…"
+    } else {
+        ""
+    });
+    excerpt
+}
