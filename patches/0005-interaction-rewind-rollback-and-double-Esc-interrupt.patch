+
+    write_file(workspace.path(), "src/main.rs", b"v2");
+    write_file(workspace.path(), "new-file.txt", b"extra");
+    write_file(workspace.path(), "new-dir/nested.txt", b"nested");
+
+    let restored = restore_snapshot(
+        codex_home.path(),
+        workspace.path(),
+        /*index*/ 1,
+        /*respect_gitignore*/ true,
+    )
+    .expect("restore");
+    assert_eq!(restored, 1);
+    assert_eq!(
+        fs::read(workspace.path().join("src/main.rs")).expect("read"),
+        b"v1"
+    );
+    assert!(!workspace.path().join("new-file.txt").exists());
+    assert!(!workspace.path().join("new-dir/nested.txt").exists());
